# Bun
bun.lock

# Docker bind-mount data dir (mysql/redis data, backend uploads/storage/logs,
# certbot certs -- includes dev-certs/generate.sh's self-signed output, which
# now lands under data/certbot/conf/live/ instead of dev-certs/ itself)
/infrastructure/docker/data/

# Ignore .env files, which may contain secrets. See
.env

# Scratch dir for local secrets/backups/DB dumps -- not just .env files (see
# do-not-commit/local-test/, which also holds .env.compose and production
# data snapshots that don't match the generic .env pattern above).
/do-not-commit/

# Built Android release artifacts (scripts/build-android-beta-release.sh)
/releases/android/

# Migration runner report output (apps/dgfy-migration-runner local invocations)
/tmp/dgfy-migration-reports/

# Verification and test reports (generated locally, environment-specific)
/reports/

# GSD (Get Stuff Done) local planning scaffolding — not tracked
/.planning/
.claude/gsd-core/
.claude/commands/gsd-*.md
.claude/agents/gsd-*.md
