# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage
/apps/dgfy-api/coverage/

# Playwright local artifacts and secrets
/apps/dgfy-web/playwright-report/
/apps/dgfy-web/test-results/
/apps/dgfy-web/playwright/.auth/
/apps/dgfy-web/.env.e2e

# Legacy frontend local artifacts and secrets. The maintained Playwright
# workspace lives under apps/dgfy-web, but local compatibility runs may still
# write the same sensitive/generated files under frontend/.
/frontend/dist/
/frontend/playwright-report/
/frontend/test-results/
/frontend/playwright/.auth/
/frontend/.env.e2e

# Vite writes one of these next to a vite.config.js whenever the config file
# itself uses top-level await / ESM features Node can't load directly.
**/vite.config.js.timestamp-*.mjs

# Production
/build
/dist
apps/dgfy-web/dist/

# Environment variables
.env
.env.local
.env.qa.local
.env.qa.secrets.local
.env.prod.local
.env.development.local
.env.test.local
.env.production.local
docs/ops/*.local.md

# Logs
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

