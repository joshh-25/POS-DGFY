RELEASE_TARGET_SHA=

# QA API contract smoke inputs
QA_BASE_URL=https://qa.example.com
# Use the currently active QA tenant token (do not rely on token-original fallback).
# If tenant tokens rotate, update this value before running release gates.
QA_COMPANY_TOKEN=replace_me_active_tenant_token
# Credentials must belong to the tenant selected by QA_COMPANY_TOKEN.
QA_EMAIL=replace_me
QA_PASSWORD=replace_me
# Optional: provide this instead of QA_EMAIL/QA_PASSWORD
QA_AUTH_JWT=

# QA drill + deploy-summary SSH inputs
QA_SSH_HOST=qa-host.example.com
QA_SSH_PORT=22
QA_SSH_USER=root
QA_APP_DIR=/var/www/skupervisor

# Optional artifact override paths
QA_VERIFY_OUTPUT=
QA_ROLLBACK_DRILL_OUTPUT=
QA_RESTORE_DRILL_OUTPUT=
# If omitted, the gate reads/writes .tmp/release-gates/<RELEASE_TARGET_SHA>/qa_deploy_summary.txt
QA_DEPLOY_SUMMARY_FILE=

# Apply-mode only (optional by default)
QA_ROLLBACK_DRILL_APPLY=0
QA_RESTORE_DRILL_APPLY=0
QA_RESTORE_BACKUP_FILE=

# Optional Sentry observability. Disabled by default; set SENTRY_ENABLED=true
# and provide DSNs to activate server-side error reporting.
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=qa
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Optional frontend build-time Sentry config. Static Vite bundles require a
# rebuild after changing these values.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN_SKUPERVISOR=
VITE_SENTRY_DSN_POS=
VITE_SENTRY_DSN_STORE=
VITE_SENTRY_ENVIRONMENT=qa
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT_SKUPERVISOR=
SENTRY_PROJECT_POS=
SENTRY_PROJECT_STORE=
SENTRY_URL=
