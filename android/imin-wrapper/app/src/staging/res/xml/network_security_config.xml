<?xml version="1.0" encoding="utf-8"?>
<!--
  Staging-flavor only. See the dev flavor's twin of this file
  (app/src/dev/res/xml/network_security_config.xml) for the full rationale;
  same shape, scoped to stage.dgfy.ph instead of dev.dgfy.ph.
  stage.dgfy.ph is confirmed to terminate TLS upstream (openresty; see
  infrastructure/nginx-host/stage.dgfy.ph.conf), so this is a defensive
  fallback, not an expected path.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">stage.dgfy.ph</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.123.37.45</domain>
    </domain-config>
</network-security-config>
