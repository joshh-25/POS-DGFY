<?xml version="1.0" encoding="utf-8"?>
<!--
  Staging-flavor only. See the dev flavor's twin of this file
  (app/src/dev/res/xml/network_security_config.xml) for the full rationale;
  same shape, scoped to stage.dgfy.ph instead of dev.dgfy.ph.

  This used to claim stage.dgfy.ph was "confirmed to terminate TLS upstream
  (openresty; see infrastructure/nginx-host/stage.dgfy.ph.conf)" -- that file
  turned out to have no TLS config at all (plain `listen 80` only), so it
  didn't actually confirm anything. The cleartext carve-out for
  stage.dgfy.ph is removed for the same reason as dev: silently falling back
  to HTTP defeats HTTPS enforcement. If TLS isn't live on
  pos.stage.dgfy.ph/stage.dgfy.ph, the staging build is now expected to fail
  to load rather than fall back to cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.123.37.45</domain>
    </domain-config>
</network-security-config>
