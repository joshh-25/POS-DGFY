<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-flavor only. pos.dev.dgfy.ph / skupervisor.dev.dgfy.ph are expected to
  serve HTTPS (see AppConfig.kt / build.gradle.kts posOrigins), but that
  DNS entry was inferred from convention, not confirmed live -- see
  android/imin-wrapper/README.md. This config permits cleartext as a
  fallback ONLY for the dev domain and known local/emulator hosts, so a
  dev build still loads if TLS on pos.dev.dgfy.ph turns out to be missing.

  base-config keeps cleartext blocked for everything else, matching the
  release build type's usesCleartextTraffic="false" default -- this file
  narrows that default, it does not remove it. prod and beta carry no
  network security config at all and stay strictly HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dev.dgfy.ph</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.123.37.45</domain>
    </domain-config>
</network-security-config>
