<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/status_logo"
            android:layout_width="180dp"
            android:layout_height="72dp"
            android:adjustViewBounds="true"
            android:contentDescription="DGFY"
            android:scaleType="fitCenter"
            android:src="@drawable/dgfy_receipt_logo" />

        <ProgressBar
            android:id="@+id/status_spinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#60A5FA" />

        <TextView
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DGFY POS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Preparing your terminal..."
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <Button
            android:id="@+id/status_retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#2563EB"
            android:paddingLeft="24dp"
            android:paddingTop="10dp"
            android:paddingRight="24dp"
            android:paddingBottom="10dp"
            android:text="Retry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
