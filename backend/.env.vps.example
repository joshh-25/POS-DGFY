# VPS / Redis-capable hosting profile
# Copy to backend/.env on the Redis-capable host and replace every placeholder value.

NODE_ENV=production
HOSTING_PROFILE=vps
HOSTING_INSTANCE_COUNT=1
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sku_inventory_manager
DB_USER=sku_inventory_user
DB_PASSWORD=replace_with_mysql_password
DB_DIALECT=mysql
DB_AUTO_SYNC=false

JWT_SECRET=replace_with_64_char_random_jwt_secret
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace_with_different_64_char_random_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

CORS_ORIGIN=https://your-domain.example,https://pos.your-domain.example,https://store.your-domain.example
PUBLIC_API_CORS_ORIGIN=https://mapviu.com,https://*.mapviu.com
TRUST_PROXY=true
ENFORCE_HTTPS=true

REDIS_URL=redis://127.0.0.1:6379
AUTH_BLACKLIST_FAILURE_MODE=fail_closed
TEMP_FILE_STORAGE=auto
STOREFRONT_DISCOVERY_REDIS_CACHE_ENABLED=true
CUSTOMER_ACCESS_MODES_ENABLED=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_TENANT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_TENANT_REGISTRATION_MAX_REQUESTS=5

PAYMENTS_ENABLED=false
TENANT_REGISTRATION_APPROVAL_MODE=manual

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_app_password
EMAIL_FROM=replace_with_sender_email
EMAIL_FROM_NAME=SKUpervisor
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_DELIVERY_FALLBACK_TO_BREVO_API=true
BREVO_API_KEY=replace_with_brevo_api_key_if_smtp_ports_are_blocked
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
