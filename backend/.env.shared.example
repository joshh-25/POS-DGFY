# Shared hosting profile (no Redis)
# Copy to backend/.env on the shared host and replace every placeholder value.

NODE_ENV=production
HOSTING_PROFILE=shared
HOSTING_INSTANCE_COUNT=1
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_sku_inventory
DB_USER=cpaneluser_sku_inventory
DB_PASSWORD=replace_with_cpanel_mysql_password
DB_DIALECT=mysql
DB_AUTO_SYNC=false

JWT_SECRET=replace_with_64_char_random_jwt_secret
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace_with_different_64_char_random_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

CORS_ORIGIN=https://your-domain.example,https://pos.your-domain.example,https://store.your-domain.example
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.dgfy.ph
TRUST_PROXY=true
ENFORCE_HTTPS=true

# Redis intentionally omitted in shared profile.
AUTH_BLACKLIST_FAILURE_MODE=fail_open
TEMP_FILE_STORAGE=local
STOREFRONT_DISCOVERY_REDIS_CACHE_ENABLED=false
CUSTOMER_ACCESS_MODES_ENABLED=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_STORE_TRACKING_READ_WINDOW_MS=900000
RATE_LIMIT_STORE_TRACKING_READ_MAX_REQUESTS=240
RATE_LIMIT_DGFY_TENANT_SESSION_WINDOW_MS=900000
RATE_LIMIT_DGFY_TENANT_SESSION_MAX_REQUESTS=10
RATE_LIMIT_TENANT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_TENANT_REGISTRATION_MAX_REQUESTS=5

PAYMENTS_ENABLED=false
TENANT_REGISTRATION_APPROVAL_MODE=manual

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_app_password
EMAIL_FROM=replace_with_sender_email
EMAIL_FROM_NAME=SKUpervisor
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_DELIVERY_FALLBACK_TO_BREVO_API=true
BREVO_API_KEY=replace_with_brevo_api_key_if_smtp_ports_are_blocked
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

APP_URL=https://your-domain.example
FRONTEND_URL=https://your-domain.example
