# SKU Inventory Manager - Environment Configuration Template
# Copy this file to .env and configure with your actual values
#
# WARNING: Never commit the .env file to version control!

# Application Environment
NODE_ENV=development
PORT=5000
# Error stack console logging policy:
# - true  => always print stack traces to console for 5xx errors
# - false => never print stack traces to console
# Default when unset:
# - development: true
# - test/production: false
# ERROR_LOG_STACKS=false

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sku_inventory_manager
# SECURITY REQUIREMENT: In production, these MUST be set to your actual database credentials.
# The system NO LONGER uses 'root' or empty password as fallbacks in production mode.
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql
# Schema auto-sync safety:
# Keep disabled by default to avoid transient 5xx during startup caused by
# `sequelize.sync({ alter: true })` on live PM2 restarts.
# Enable only for controlled local schema experiments.
DB_AUTO_SYNC=false

# Schema Index Audit (runtime health degradation + CI guard)
# Defaults:
# - Enabled in production when not set
# - Disabled in test when not set
# SCHEMA_INDEX_AUDIT_ENABLED=true
# SCHEMA_INDEX_AUDIT_INTERVAL_MINUTES=360
# SCHEMA_INDEX_AUDIT_TIMEOUT_MS=5000

# JWT Configuration
# SECURITY REQUIREMENT: Secrets must be at least 32 characters long
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_SECRET_AT_LEAST_32_CHARACTERS_LONG
REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
# Comma-separated allowlist for all local/prod frontends that call backend APIs directly.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://skupervisor.surebizcorp.com,https://surebizcorp.com,https://pos.surebizcorp.com,https://store.surebizcorp.com,https://skupervisor.dgfy.ph,https://pos.dgfy.ph,https://dgfy.ph,https://store.dgfy.ph
PUBLIC_API_CORS_ORIGIN=https://mapviu.com,https://*.mapviu.com

# Company registration approval mode.
# manual: standard registrations stay pending until platform admin approval.
# auto_standard: standard registrations are provisioned immediately and can log in right after registration.
# manual: keep registrations pending until platform-admin approval.
TENANT_REGISTRATION_APPROVAL_MODE=auto_standard

# Default storefront bootstrap location for newly provisioned/approved tenants.
# This ensures each newly activated tenant gets an auto-generated public page
# (slug + primary storefront pin) without manual location creation.
# Accepted ranges:
# - latitude: -90 to 90
# - longitude: -180 to 180
# - delivery radius: 0.1 to 100 (km)
# - wait minutes: 0 to 240
STOREFRONT_DEFAULT_LOCATION_NAME=Main Branch
STOREFRONT_DEFAULT_LOCATION_ADDRESS=Iloilo City
STOREFRONT_DEFAULT_LATITUDE=10.699817
STOREFRONT_DEFAULT_LONGITUDE=122.559893
STOREFRONT_DEFAULT_DELIVERY_RADIUS_KM=5
STOREFRONT_DEFAULT_WAIT_MINUTES=15
# Optional retry behavior for storefront discovery sync after mutations
# STOREFRONT_DISCOVERY_SYNC_RETRY_DELAYS_MS=0,250,800
# STOREFRONT_DISCOVERY_SIGNATURE_TTL_MS=1000

# Customer Access Mode runtime enforcement is on by default. Set false only for rollback.
# ghost/catalog/inquiry tenants cannot quote, checkout, or book while transaction tenants still can.
CUSTOMER_ACCESS_MODES_ENABLED=true
# Optional comma-separated tenant IDs, company tokens, slugs, or names for canary re-enablement while rollback is active.
CUSTOMER_ACCESS_MODES_ENABLED_TENANTS=

# Redis Configuration (Optional - for caching and token blacklist)
REDIS_URL=redis://localhost:6379
# Token blacklist behavior when Redis is unavailable:
# - fail_open  => continue auth flow (recommended for local/dev)
# - fail_closed => block auth flow with 503 (recommended for production if strict security posture is required)
# Default behavior when unset:
# - production: fail_closed
# - non-production: fail_open
# AUTH_BLACKLIST_FAILURE_MODE=fail_open

# Original legacy account normalization controls
# These are used by backend/scripts/register_original_tenant.js and
# backend/scripts/audit_original_legacy_account.js.
ORIGINAL_LEGACY_DB_NAME=sku_inventory_manager
ORIGINAL_LEGACY_COMPANY_TOKEN=token-original
ORIGINAL_LEGACY_TENANT_NAME=Original Legacy Data
ORIGINAL_LEGACY_ADMIN_EMAIL=admin@test.com
# ORIGINAL_LEGACY_ADMIN_USERNAME=admin
# ORIGINAL_LEGACY_ADMIN_PASSWORD=change_me_before_production_use
# ORIGINAL_LEGACY_ACCOUNT_MODE=auto
# ORIGINAL_LEGACY_SCRIPT_MODE=apply
# ORIGINAL_LEGACY_STRICT=false
# ORIGINAL_LEGACY_ALLOW_TOKEN_ROTATION=false
# ORIGINAL_LEGACY_AUDIT_STRICT=true

# Trust Proxy Configuration (Nginx/Apache)
# Set to 'true' if running behind a reverse proxy
# Automatically enabled if NODE_ENV=production
# TRUST_PROXY=false

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX_REQUESTS=5
# Public company registration limiter. Keep strict when auto-standard approval is enabled.
# RATE_LIMIT_TENANT_REGISTRATION_WINDOW_MS=3600000
# RATE_LIMIT_TENANT_REGISTRATION_MAX_REQUESTS=5
# DISABLE_RATE_LIMIT=false

# Email Configuration (for user invitations and notifications)
# Used for: user invitations, company approval/rejection notifications
#
# ============================================
# GMAIL SMTP SETUP (Recommended for testing)
# ============================================
# Local/testing Gmail SMTP requires an App Password. A normal Gmail password
# will fail with EAUTH/535 BadCredentials.
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and "Other (Custom name)"
#    - Name it "SKUpervisor"
#    - Copy the 16-character password (remove spaces)
# 3. Use these Gmail settings:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=xxxx-xxxx-xxxx-xxxx (your 16-char app password, no spaces)
#    EMAIL_FROM=your-email@gmail.com
#
# Gmail Limits: 500 emails/day (personal), 2000/day (Workspace)
# Note: EMAIL_FROM must match SMTP_USER for Gmail
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=SKUpervisor
# Email delivery provider:
# - auto: use SMTP and fall back to Brevo HTTPS API when BREVO_API_KEY is configured
# - smtp: require SMTP settings
# - brevo_api: send through Brevo HTTPS API only
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_DELIVERY_FALLBACK_TO_BREVO_API=true
# Brevo HTTPS API fallback for hosts where outbound SMTP ports are blocked.
# Requires a verified Brevo sender matching EMAIL_FROM.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_OTP_ENFORCEMENT_ENABLED=true
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
# EMAIL_OTP_SECRET=change_me_to_a_long_random_secret
RATE_LIMIT_EMAIL_OTP_WINDOW_MS=600000
RATE_LIMIT_EMAIL_OTP_MAX_REQUESTS=3

# Application URL (used for email links - invitations, login, etc.)
APP_URL=https://skupervisor.surebizcorp.com
FRONTEND_URL=https://skupervisor.surebizcorp.com
# # PayPal Configuration (DISABLED - switching to PayMongo)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# # Plan IDs for subscription verification/migration/reactivation
# PAYPAL_STANDARD_PLAN_ID=P-XXXXXXXXXXXX
# PAYPAL_PREMIUM_PLAN_ID=P-YYYYYYYYYYYY
# # Legacy fallback (older premium env key; keep only while migrating old deployments)
# # PAYPAL_PLAN_ID=P-YYYYYYYYYYYY

# PayMongo Configuration (NEW - replacing PayPal)
PAYMONGO_MODE=test
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
# Optional mode-specific overrides (recommended in production):
# PAYMONGO_TEST_PUBLIC_KEY=pk_test_...
# PAYMONGO_TEST_SECRET_KEY=sk_test_...
# PAYMONGO_LIVE_PUBLIC_KEY=pk_live_...
# PAYMONGO_LIVE_SECRET_KEY=sk_live_...
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here
# PayMongo Payment Sources / Subscription Plan IDs
PAYMONGO_STANDARD_PLAN_ID=source_xxx_standard
PAYMONGO_PREMIUM_PLAN_ID=source_xxx_premium
