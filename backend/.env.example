# SKU Inventory Manager - Environment Configuration Template
# Copy this file to .env and configure with your actual values
#
# WARNING: Never commit the .env file to version control!

# Application Environment
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sku_inventory_manager
# SECURITY REQUIREMENT: In production, these MUST be set to your actual database credentials.
# The system NO LONGER uses 'root' or empty password as fallbacks in production mode.
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Schema Index Audit (runtime health degradation + CI guard)
# Defaults:
# - Enabled in production when not set
# - Disabled in test when not set
# SCHEMA_INDEX_AUDIT_ENABLED=true
# SCHEMA_INDEX_AUDIT_INTERVAL_MINUTES=360
# SCHEMA_INDEX_AUDIT_TIMEOUT_MS=5000

# JWT Configuration
# SECURITY REQUIREMENT: Secrets must be at least 32 characters long
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_A_DIFFERENT_STRONG_SECRET_AT_LEAST_32_CHARACTERS_LONG
REFRESH_TOKEN_EXPIRY=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Redis Configuration (Optional - for caching and token blacklist)
REDIS_URL=redis://localhost:6379

# Trust Proxy Configuration (Nginx/Apache)
# Set to 'true' if running behind a reverse proxy
# Automatically enabled if NODE_ENV=production
# TRUST_PROXY=false

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX_REQUESTS=5
# DISABLE_RATE_LIMIT=false

# Email Configuration (for user invitations and notifications)
# Used for: user invitations, company approval/rejection notifications
#
# ============================================
# GMAIL SMTP SETUP (Recommended for testing)
# ============================================
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select "Mail" and "Other (Custom name)"
#    - Name it "SKU Inventory Manager"
#    - Copy the 16-character password (remove spaces)
# 3. Use these Gmail settings:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_SECURE=false
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=xxxx-xxxx-xxxx-xxxx (your 16-char app password, no spaces)
#    EMAIL_FROM=your-email@gmail.com
#
# Gmail Limits: 500 emails/day (personal), 2000/day (Workspace)
# Note: EMAIL_FROM must match SMTP_USER for Gmail
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=SKU Inventory Manager

# Application URL (used for email links - invitations, login, etc.)
# # PayPal Configuration (DISABLED - switching to PayMongo)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# # Plan IDs for subscription verification/migration/reactivation
# PAYPAL_STANDARD_PLAN_ID=P-XXXXXXXXXXXX
# PAYPAL_PREMIUM_PLAN_ID=P-YYYYYYYYYYYY
# # Legacy fallback (older premium env key; keep only while migrating old deployments)
# # PAYPAL_PLAN_ID=P-YYYYYYYYYYYY

# PayMongo Configuration (NEW - replacing PayPal)
PAYMONGO_MODE=test
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_WEBHOOK_SECRET=your_webhook_secret_here
# PayMongo Payment Sources / Subscription Plan IDs
PAYMONGO_STANDARD_PLAN_ID=source_xxx_standard
PAYMONGO_PREMIUM_PLAN_ID=source_xxx_premium
