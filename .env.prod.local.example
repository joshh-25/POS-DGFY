# Production API contract smoke inputs
PROD_BASE_URL=https://skupervisor.surebizcorp.com
PROD_COMPANY_TOKEN=replace_with_active_tenant_token
PROD_EMAIL=admin@test.com
PROD_PASSWORD=Admin123!

# Optional: provide this instead of PROD_EMAIL/PROD_PASSWORD
PROD_AUTH_JWT=

# Optional artifact override path
PROD_VERIFY_OUTPUT=

# Optional Sentry observability. Disabled by default; set SENTRY_ENABLED=true
# and provide DSNs to activate server-side error reporting.
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Optional frontend build-time Sentry config. Static Vite bundles require a
# rebuild after changing these values.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN_SKUPERVISOR=
VITE_SENTRY_DSN_POS=
VITE_SENTRY_DSN_STORE=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT_SKUPERVISOR=
SENTRY_PROJECT_POS=
SENTRY_PROJECT_STORE=
SENTRY_URL=
