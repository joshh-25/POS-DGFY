# Docker only reads <build context>/.dockerignore, and every image here
# builds with `context: .` (repo root) -- apps/dgfy-api/.dockerignore is
# never actually consulted. This supersedes it.

# VCS / editor / agent tooling
/.git
/.github
/.agent
/.claude
/.codex
/.cursor
/.husky
/tmp

# Top-level directories no Dockerfile COPYs from
/Standalone POS
/output
/backups
/docs
/scripts
/mobile
/android
/System_Audit
/release-controller
/packages/*
!/packages/pos-receipt
!/packages/shared-constants
!/packages/web-core
/artifacts
/nginx
/skills

# Dependency / build-output / local-only noise, at any depth
#
# node_modules/.env/.env.* need the explicit **/ prefix -- unlike .gitignore,
# .dockerignore patterns are root-anchored by default, so the bare forms below
# matched only the repo-root copies. Each apps/dgfy-{ims,pos,storefront}/
# node_modules (~1GB combined) and apps/dgfy-api/node_modules (~330MB) were
# slipping into the build context, which is also a correctness bug: each
# per-app Dockerfile's `COPY apps/dgfy-<x>/ ./` (after `npm ci`) would
# overwrite the image's Linux node_modules with the host's macOS one if it
# weren't excluded.
**/node_modules
**/dist
desktop-dist
coverage
npm-debug.log*
bun.lock
*.md

# Local dev state not needed at build time, at any depth
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
logs
uploads
storage
device-bridge
tests
config

# Local-only scratch/state dirs -- multi-GB production data snapshots and
# Docker bind-mount state that no Dockerfile COPYs from, but which otherwise
# get tarred into the build context on every build. See .gitignore for why
# these exist on disk at all.
/do-not-commit
/infrastructure/docker/data
