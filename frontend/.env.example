# Frontend environment template
# Copy to .env for local development.

VITE_API_URL=/api/v1

VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_STANDARD_PLAN_ID=P-XXXXXXXXXXXX
VITE_PAYPAL_PREMIUM_PLAN_ID=P-YYYYYYYYYYYY
# Legacy fallback (older premium env key; optional during migration)
# VITE_PAYPAL_PLAN_ID=P-YYYYYYYYYYYY

# Storefront app runtime API origin (optional)
# Useful when store app is served from :5175 preview/runtime.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Store app base path (set `/tenant-store/` for production path-based hosting).
# Keep `/` for local dev server.
# VITE_STORE_BASE_PATH=/tenant-store/

# Optional manual build stamp override for storefront build badge.
# If omitted, build time ISO timestamp is used.
# VITE_BUILD_STAMP=2026-03-31T00:00:00.000Z
