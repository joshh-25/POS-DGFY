# Frontend shared hosting profile
# Use when the frontend is served from the same domain or shared-hosted app path.

VITE_API_URL=/api/v1
VITE_API_BASE_URL=https://your-domain.example
VITE_ASSET_BASE_URL=https://your-domain.example
VITE_STORE_BASE_PATH=/tenant-store/
VITE_TENANT_STORE_BASE_PATH=/tenant-store
VITE_ROOT_TENANT_SLUGS=false
VITE_PAYMENTS_ENABLED=false
# PDF Menu Import (quick/temporary feature — env-gated, default off; backend
# also requires MENU_IMPORT_ENABLED + OPENAI_API_KEY)
VITE_MENU_PDF_IMPORT_ENABLED=false
