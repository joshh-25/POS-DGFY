# Copy this file to .env.e2e. Do not commit the copy.
# The default URLs are detected from the local Vite and backend configuration.
E2E_BASE_URL=http://localhost:5174
E2E_API_URL=http://localhost:5000

# Required only for authenticated tests and reusable auth storage state.
# Use a dedicated, non-production account.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
# Optional when the account lookup cannot identify a single company.
E2E_TEST_COMPANY_TOKEN=
