{
  "name": "skupervisor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:skupervisor": "vite --config apps/skupervisor/vite.config.js --host",
    "dev:pos": "vite --config apps/pos/vite.config.js --host",
    "dev:store": "vite --config apps/store/vite.config.js --host",
    "build": "vite build",
    "build:all": "npm run build:skupervisor && npm run build:pos && npm run build:store",
    "build:skupervisor": "vite build --config apps/skupervisor/vite.config.js",
    "build:pos": "vite build --config apps/pos/vite.config.js",
    "build:store": "vite build --config apps/store/vite.config.js",
    "preview": "vite preview",
    "lint": "eslint src apps --ext .js,.jsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "axios": "^1.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.33",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^1.2.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "vitest": "^4.0.18"
  }
}
