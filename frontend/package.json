{
  "name": "skupervisor",
  "version": "1.0.0",
  "description": "DGFY multi-surface frontend workspace, including the standalone POS desktop shell.",
  "author": "DGFY",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:skupervisor": "vite --config apps/skupervisor/vite.config.js --host",
    "dev:pos": "vite --config apps/pos/vite.config.js --host",
    "dev:store": "vite --config apps/store/vite.config.js --host",
    "desktop:pos": "electron desktop/pos-electron/main.cjs",
    "build": "vite build",
    "build:all": "npm run build:skupervisor && npm run build:pos && npm run build:store",
    "build:skupervisor": "vite build --config apps/skupervisor/vite.config.js",
    "build:pos": "vite build --config apps/pos/vite.config.js",
    "build:store": "vite build --config apps/store/vite.config.js",
    "build:pos:desktop": "npm run build:pos && electron-builder --config desktop/pos-electron/electron-builder.json",
    "preview": "vite preview",
    "lint": "eslint src apps --ext .js,.jsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:lighthouse": "lhci autorun",
    "test:load": "k6 run tests/load/smoke-load.js",
    "test:load:api": "k6 run tests/load/api-load.js",
    "test:security": "playwright test tests/e2e/security-auth.spec.js tests/e2e/security-input.spec.js tests/e2e/security-headers.spec.js",
    "security:audit": "npm audit",
    "security:all": "npm audit && npm run test:security"
  },
  "dependencies": {
    "@dgfy/pos-receipt": "file:../packages/pos-receipt",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "fuse.js": "^7.4.2",
    "jwt-decode": "^4.0.0",
    "katex": "^0.16.33",
    "lucide-react": "^0.294.0",
    "maplibre-gl": "^5.24.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^1.2.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "axios-mock-adapter": "^2.1.0",
    "dotenv": "^16.6.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "jsdom": "^29.0.2",
    "lodash": "^4.18.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^6.4.3",
    "vitest": "^4.0.18"
  }
}
