# operator-supplied migration target objects. Each entry:
#   { "legacy_tenant_id": "...", "legacy_tenant_db_name": "...",
#     "target_business_db_name": "dgfy_business_...",
#     "expected_business_id": "...", "expected_owner_account_id": "..." }
