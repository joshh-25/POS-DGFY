# dgfy-migration-runner - Environment Configuration Template
# Copy this file to .env and configure with your actual values.
#
# Optional for default local dev: the defaults baked into
# src/config/sequelize.config.cjs (root / '' / sku_inventory_manager /
# localhost / 3306) already match a default local MySQL install. Only
# needed to override (e.g. a real DB password).
#
# These values MUST match apps/dgfy-api/.env's DB_HOST/DB_PORT/DB_NAME/
# DB_USER/DB_PASSWORD -- this package migrates the same landlord database
# apps/dgfy-api connects to, and nothing enforces that they stay in sync.
# A mismatch here means migrations silently run against a different
# database than the one the API actually serves.
#
# Not used in the containerized/Docker path -- there, DB_HOST/DB_PORT/
# DB_DIALECT are fixed by infrastructure/docker/docker-compose.yml
# (always the in-network `mysql` service), and DB_NAME/DB_USER/
# DB_PASSWORD come from infrastructure/docker/.env instead. This file is
# for running `npm run migrate`/`npm run seed` directly on your host.
#
# WARNING: Never commit the .env file to version control!

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sku_inventory_manager
DB_USER=root
DB_PASSWORD=

# Optional: print every SQL statement to console.
SEQUELIZE_LOG_SQL=false
