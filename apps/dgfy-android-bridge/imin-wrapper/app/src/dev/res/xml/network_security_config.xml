<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-flavor only. pos.dev.dgfy.ph / skupervisor.dev.dgfy.ph must serve HTTPS
  (see AppConfig.kt / build.gradle.kts posOrigins) -- dev.dgfy.ph used to have
  a cleartext carve-out here "in case TLS turns out to be missing," but that
  defeated the point of enforcing HTTPS at all: Android would silently
  complete a plain-HTTP connection to the live domain any time TLS wasn't up,
  instead of failing loudly. It's removed. If pos.dev.dgfy.ph doesn't serve
  HTTPS, the dev build is now expected to fail to load rather than fall back
  to cleartext -- that's the server side to fix, not this file.

  base-config keeps cleartext blocked for everything except the emulator
  loopback and LAN preview host used for local development against a Vite
  dev server (WebPosNavigationPolicy also gates in-app navigation on scheme,
  see WebPosActivity.kt). prod and beta carry no network security config at
  all and stay strictly HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.123.37.45</domain>
    </domain-config>
</network-security-config>
