<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-flavor-only manifest fragment. The Gradle manifest merger combines
  this with app/src/main/AndroidManifest.xml; its only job is attaching
  android:networkSecurityConfig to <application>, scoped to this flavor so
  prod/staging are completely untouched.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
