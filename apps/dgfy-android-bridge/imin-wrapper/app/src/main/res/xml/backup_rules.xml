<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- native_pos contains session/company tokens; pos_device_identity
         contains the metadata paired with the non-exportable Keystore key.
         Neither file may be copied to another installation. -->
    <exclude domain="sharedpref" path="native_pos" />
    <exclude domain="sharedpref" path="pos_device_identity" />
</full-backup-content>
