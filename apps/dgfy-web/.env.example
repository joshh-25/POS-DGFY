VITE_TEST_USER_EMAIL=admin@test.com
VITE_TEST_USER_PASSWORD=Admin123!
VITE_TEST_ADMIN_EMAIL=superadmin@test.com
VITE_TEST_ADMIN_PASSWORD=SuperAdmin123!
VITE_TEST_BASE_URL=http://localhost:5173

# Optional browser Sentry error tracking. Disabled by default; a missing DSN
# never blocks the dev server or a build. See infrastructure/docker/SENTRY.md.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN_SKUPERVISOR=
VITE_SENTRY_DSN_POS=
VITE_SENTRY_DSN_STORE=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
# 0 or empty = propagation-only (trace ids flow, NO transactions billed).
# Set >0 only to also collect browser performance spans.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
VITE_SENTRY_TRACE_PROPAGATION_TARGETS=
# Emergency kill switch for distributed tracing. Empty means ENABLED --
# the opposite polarity to VITE_SENTRY_ENABLED, so a mis-threaded build
# arg fails towards "tracing works" instead of silently dead. Set false
# (plus a frontend rebuild) to stop sending sentry-trace/baggage headers.
VITE_SENTRY_TRACE_PROPAGATION_ENABLED=
VITE_SENTRY_DEBUG=false
