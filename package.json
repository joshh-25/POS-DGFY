{
  "name": "sku-inventory-manager",
  "version": "1.0.0",
  "description": "SKU Inventory Manager - Monorepo with Frontend and Backend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:skupervisor": "cd frontend && npm run dev:skupervisor",
    "dev:pos": "cd frontend && npm run dev:pos",
    "dev:store": "cd frontend && npm run dev:store",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:skupervisor": "cd frontend && npm run build:skupervisor",
    "build:pos": "cd frontend && npm run build:pos",
    "build:store": "cd frontend && npm run build:store",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "cd backend && npm start",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "lint:docs": "node scripts/lint-docs.js",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.js",
    "check:docs": "npm run lint:docs",
    "validate:ai": "cd backend && npm run validate:ai",
    "generate:ai-docs": "cd backend && npm run generate:ai-docs",
    "ai:check": "cd backend && npm run ai:check",
    "doctor:runtime": "cd backend && npm run doctor:runtime",
    "audit:fifo-drift": "cd backend && npm run audit:fifo-drift",
    "audit:fifo-drift:repair": "cd backend && npm run audit:fifo-drift:repair",
    "smoke:pos-local": "cd backend && npm run smoke:pos-local",
    "check:architecture": "cd backend && npm run check:architecture-guardrails && npm run check:controller-boundaries",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "kill:dev": "bash scripts/kill-dev.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:auto": "bash scripts/deploy.sh --auto",
    "deploy:verify": "bash scripts/deploy.sh --auto --verify"
  },
  "keywords": [
    "inventory",
    "management",
    "sku",
    "fifo",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3"
  }
}
