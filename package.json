{
  "name": "sku-inventory-manager",
  "version": "1.0.0",
  "description": "SKU Inventory Manager - Monorepo with Frontend and Backend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:device-bridge\" \"npm run dev:frontend\"",
    "dev:local-pos-stack": "concurrently \"npm run dev:backend\" \"npm run dev:device-bridge\" \"npm run dev:skupervisor\" \"npm run dev:pos\" \"npm run dev:store\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:skupervisor": "cd frontend && npm run dev:skupervisor",
    "dev:pos": "cd frontend && npm run dev:pos",
    "dev:store": "cd frontend && npm run dev:store",
    "dev:backend": "cd backend && npm run dev",
    "dev:device-bridge": "cd backend && npm run dev:device-bridge",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:skupervisor": "cd frontend && npm run build:skupervisor",
    "build:pos": "cd frontend && npm run build:pos",
    "build:store": "cd frontend && npm run build:store",
    "build:backend": "cd backend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:device-bridge\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run preview",
    "start:backend": "cd backend && npm start",
    "start:device-bridge": "cd backend && npm run start:device-bridge",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:frontend:contracts": "cd frontend && npm test -- --run src/services/__tests__/adminService.interceptor.test.js apps/store/src/__tests__/hospitalityStorefront.contract.test.js apps/store/src/__tests__/storefrontMarkerPreview.test.js src/features/fnb/__tests__/fnbMode.contract.test.js apps/store/src/__tests__/fnbStorefront.contract.test.js apps/store/src/__tests__/geoSearchIntegration.contract.test.js apps/store/src/__tests__/storefrontFollow.integration.test.jsx apps/store/src/__tests__/profileLauncher.integration.test.jsx apps/store/src/__tests__/discoveryHeaderAccount.integration.test.jsx Components/po/__tests__/POReceiptModal.valuation.integration.test.jsx",
    "test:backend": "cd backend && npm test",
    "test:backend:matrix": "node scripts/run-backend-test-matrix.js",
    "audit:dependencies": "npm audit --json && npm --prefix backend audit --json && npm --prefix frontend audit --json",
    "audit:dependencies:prod": "npm audit --omit=dev --json && npm --prefix backend audit --omit=dev --json && npm --prefix frontend audit --omit=dev --json",
    "lint:docs": "node scripts/lint-docs.js",
    "preflight:shared": "node scripts/check-hosting-profile.js --profile shared",
    "preflight:vps": "node scripts/check-hosting-profile.js --profile vps",
    "check:production-env": "node scripts/check-production-env-fixtures.js",
    "test:hosting:shared": "cd backend && npm run test:hosting:shared",
    "test:hosting:vps": "cd backend && npm run test:hosting:vps",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.js",
    "check:merge-adoption": "node scripts/check-merge-adoption.js",
    "check:merge-adoption-required": "node scripts/check-merge-adoption-required.js",
    "check:docs": "npm run lint:docs",
    "check:multi-location-rollout": "node scripts/check-multi-location-rollout-closure.js",
    "refresh:multi-location-evidence": "node scripts/refresh-multi-location-evidence-manifest.js",
    "finalize:multi-location-evidence": "node scripts/finalize-multi-location-evidence.js",
    "validate:ai": "cd backend && npm run validate:ai",
    "generate:ai-docs": "cd backend && npm run generate:ai-docs",
    "ai:check": "cd backend && npm run ai:check",
    "doctor:runtime": "cd backend && npm run doctor:runtime",
    "verify:email": "cd backend && npm run verify:email --",
    "audit:fifo-drift": "cd backend && npm run audit:fifo-drift",
    "audit:fifo-drift:repair": "cd backend && npm run audit:fifo-drift:repair",
    "audit:location-stock-parity": "cd backend && npm run audit:location-stock-parity",
    "audit:location-stock-parity:allow-missing": "cd backend && npm run audit:location-stock-parity:allow-missing",
    "audit:location-stock-parity:repair": "cd backend && npm run audit:location-stock-parity:repair",
    "audit:storefront-public-visibility": "cd backend && npm run audit:storefront-public-visibility",
    "audit:tenant-index-headroom": "cd backend && npm run audit:tenant-index-headroom --",
    "reconcile:storefront-discovery": "cd backend && npm run reconcile:storefront-discovery --",
    "remediate:tenant-redundant-indexes": "cd backend && npm run remediate:tenant-redundant-indexes --",
    "backfill:dgfy-customer-activity": "cd backend && npm run backfill:dgfy-customer-activity --",
    "backfill:dgfy-customer-activity:apply": "cd backend && npm run backfill:dgfy-customer-activity:apply --",
    "evidence:incident": "node scripts/create-incident-bundle.js",
    "smoke:pos-local": "cd backend && npm run smoke:pos-local",
    "smoke:pos-terminal-ui": "node scripts/smoke-pos-terminal-ui.js",
    "smoke:dgfy-access-ui": "node scripts/smoke-dgfy-access-ui.js",
    "qa:fnb-readiness": "node scripts/run-fnb-readiness-gate.js",
    "check:architecture": "cd backend && npm run check:architecture-guardrails && npm run check:controller-boundaries",
    "check:compliance": "node scripts/check-compliance-impact.js && node scripts/check-compliance-api-contracts.js",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "kill:dev": "bash scripts/kill-dev.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:auto": "bash scripts/deploy.sh --auto",
    "deploy:verify": "bash scripts/deploy.sh --auto --verify",
    "verify:prod:multi-location": "powershell -ExecutionPolicy Bypass -File scripts/verify-prod-multi-location.ps1",
    "verify:qa:multi-location": "powershell -ExecutionPolicy Bypass -File scripts/verify-qa-multi-location.ps1",
    "gate:release:prod-contracts": "npm run verify:prod:multi-location",
    "gate:release:qa-contracts": "npm run verify:qa:multi-location",
    "drill:qa:rollback": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-rollback-drill.ps1",
    "drill:qa:restore": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-restore-drill.ps1",
    "evidence:qa:deploy-summary": "powershell -ExecutionPolicy Bypass -File scripts/fetch-qa-deploy-summary.ps1",
    "gate:release:no-staging:preflight": "node scripts/check-no-staging-prereqs.js",
    "gate:release:no-staging": "node scripts/gate-release-no-staging.js",
    "gate:release:no-staging:qa-env": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-release-gate.ps1",
    "gate:release:prod-contracts:env": "powershell -ExecutionPolicy Bypass -File scripts/run-prod-contract-gate.ps1",
    "gate:release:observability": "node scripts/gate-release-observability.js",
    "gate:release:local": "node scripts/gate-release-local.js",
    "uat:production:dgfy": "node scripts/run-dgfy-production-uat.js",
    "verify:release-verdict": "node scripts/verify-release-verdict.js",
    "test:deploy:namecheap": "node scripts/deploy/namecheap-shared/upload-artifacts.test.js",
    "test:merge-adoption": "node scripts/check-merge-adoption.test.js && node scripts/check-merge-adoption-required.test.js"
  },
  "keywords": [
    "inventory",
    "management",
    "sku",
    "fifo",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "basic-ftp": "^5.3.1",
    "concurrently": "^8.2.2",
    "husky": "^9.0.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3"
  }
}
