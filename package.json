{
  "name": "sku-inventory-manager",
  "version": "1.0.0",
  "description": "SKU Inventory Manager - Monorepo with Frontend and Backend",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:device-bridge\" \"npm run dev:frontend\"",
    "dev:local-pos-stack": "concurrently \"npm run dev:backend\" \"npm run dev:device-bridge\" \"npm run dev:skupervisor\" \"npm run dev:pos\" \"npm run dev:store\"",
    "dev:frontend": "npm run dev:skupervisor",
    "dev:skupervisor": "cd apps/dgfy-ims && npm run dev",
    "dev:pos": "cd apps/dgfy-pos && npm run dev",
    "dev:store": "cd apps/dgfy-storefront && npm run dev",
    "dev:backend": "cd apps/dgfy-api && npm run dev",
    "dev:device-bridge": "cd apps/dgfy-api && npm run dev:device-bridge",
    "dev:dgfy-api": "cd apps/dgfy-api && npm run dev",
    "maildev:local": "node scripts/start-maildev-local.cjs",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build:skupervisor",
    "build:skupervisor": "cd apps/dgfy-ims && npm run build",
    "build:pos": "cd apps/dgfy-pos && npm run build",
    "build:store": "cd apps/dgfy-storefront && npm run build",
    "build:backend": "cd apps/dgfy-api && npm run build",
    "install:all": "npm install && cd apps/dgfy-ims && npm install && cd ../dgfy-pos && npm install && cd ../dgfy-storefront && npm install && cd ../dgfy-api && npm install && cd ../dgfy-migration-runner && npm install",
    "start": "concurrently \"npm run start:backend\" \"npm run start:device-bridge\" \"npm run start:frontend\"",
    "start:frontend": "cd apps/dgfy-ims && npm run preview",
    "start:backend": "cd apps/dgfy-api && npm start",
    "start:device-bridge": "cd apps/dgfy-api && npm run start:device-bridge",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test:frontend:ims && npm run test:frontend:storefront",
    "test:frontend:ims": "cd apps/dgfy-ims && npm test",
    "test:frontend:storefront": "cd apps/dgfy-storefront && npm test",
    "test:frontend:contracts": "cd apps/dgfy-ims && npx vitest run contract.test integration.test",
    "test:frontend:contracts:storefront": "cd apps/dgfy-storefront && npx vitest run contract.test integration.test",
    "test:backend": "cd apps/dgfy-api && npm test",
    "test:backend:matrix": "node scripts/run-backend-test-matrix.js",
    "test:backend:fast": "node scripts/run-backend-test-matrix.js --tier fast",
    "test:backend:db": "node scripts/run-backend-test-matrix.js --tier db",
    "audit:dependencies": "node scripts/audit-dependencies.js",
    "audit:dependencies:prod": "node scripts/audit-dependencies.js --omit-dev",
    "lint:docs": "node scripts/lint-docs.js && npm run check:adr",
    "check:adr": "node scripts/check-adr.js --strict",
    "generate:adr-index": "node scripts/check-adr.js --write-index",
    "test:adr": "node --test scripts/check-adr.test.js",
    "check:compat-seams": "node scripts/check-compat-seams.js",
    "check:agent-surfaces": "node scripts/check-agent-surfaces.js",
    "check:pr-quality-workflow": "node scripts/check-pr-quality-workflow.js",
    "test:compat-seams": "node --test scripts/check-compat-seams.test.js",
    "generate:compat-inventory": "node scripts/generate-compat-inventory.js",
    "preflight:shared": "node scripts/check-hosting-profile.js --profile shared",
    "preflight:vps": "node scripts/check-hosting-profile.js --profile vps",
    "check:production-env": "node scripts/check-production-env-fixtures.js",
    "test:hosting:shared": "cd apps/dgfy-api && npm run test:hosting:shared",
    "test:hosting:vps": "cd apps/dgfy-api && npm run test:hosting:vps",
    "check:frontend-budgets": "node scripts/check-frontend-budgets.js",
    "check:batch-inventory": "node scripts/check-batch-inventory.js",
    "check:documentation-closure": "node scripts/check-documentation-closure.js",
    "validate:batch-inventory": "node scripts/validate-batch-inventory.js",
    "check:regression-risk": "node scripts/check-regression-risk.js",
    "find:reviewed-batch-manifest": "node scripts/find-reviewed-batch-manifest.js",
    "check:qa-target-proof": "node scripts/check-qa-target-proof.js",
    "check:deploy-source-contract": "node scripts/check-deploy-source-contract.js",
    "check:merge-hygiene": "node scripts/check-merge-hygiene.js",
    "check:merge-adoption": "node scripts/check-merge-adoption.js",
    "check:merge-adoption-required": "node scripts/check-merge-adoption-required.js",
    "report:frontend-split-sync": "node scripts/report-frontend-split-sync.js",
    "report:frontend-split-sync:post-merge": "node scripts/report-frontend-split-sync.js --post-merge --strict",
    "test:frontend-split-sync": "node --test scripts/report-frontend-split-sync.test.js",
    "check:docs": "npm run lint:docs",
    "check:multi-location-rollout": "node scripts/check-multi-location-rollout-closure.js",
    "refresh:multi-location-evidence": "node scripts/refresh-multi-location-evidence-manifest.js",
    "finalize:multi-location-evidence": "node scripts/finalize-multi-location-evidence.js",
    "validate:ai": "cd apps/dgfy-api && npm run validate:ai",
    "generate:ai-docs": "cd apps/dgfy-api && npm run generate:ai-docs",
    "ai:check": "cd apps/dgfy-api && npm run ai:check",
    "doctor:runtime": "cd apps/dgfy-api && npm run doctor:runtime",
    "verify:email": "cd apps/dgfy-api && npm run verify:email --",
    "audit:fifo-drift": "cd apps/dgfy-api && npm run audit:fifo-drift",
    "audit:fifo-drift:repair": "cd apps/dgfy-api && npm run audit:fifo-drift:repair",
    "audit:location-stock-parity": "cd apps/dgfy-api && npm run audit:location-stock-parity",
    "audit:location-stock-parity:allow-missing": "cd apps/dgfy-api && npm run audit:location-stock-parity:allow-missing",
    "audit:location-stock-parity:repair": "cd apps/dgfy-api && npm run audit:location-stock-parity:repair",
    "audit:storefront-public-visibility": "cd apps/dgfy-api && npm run audit:storefront-public-visibility",
    "audit:tenant-index-headroom": "cd apps/dgfy-api && npm run audit:tenant-index-headroom --",
    "reconcile:storefront-discovery": "cd apps/dgfy-api && npm run reconcile:storefront-discovery --",
    "remediate:tenant-redundant-indexes": "cd apps/dgfy-api && npm run remediate:tenant-redundant-indexes --",
    "backfill:dgfy-customer-activity": "cd apps/dgfy-api && npm run backfill:dgfy-customer-activity --",
    "backfill:dgfy-customer-activity:apply": "cd apps/dgfy-api && npm run backfill:dgfy-customer-activity:apply --",
    "evidence:incident": "node scripts/create-incident-bundle.js",
    "smoke:pos-local": "cd apps/dgfy-api && npm run smoke:pos-local",
    "smoke:pos-terminal-ui": "node scripts/smoke-pos-terminal-ui.js",
    "smoke:dgfy-access-ui": "node scripts/smoke-dgfy-access-ui.js",
    "qa:fnb-readiness": "node scripts/run-fnb-readiness-gate.js",
    "check:architecture": "cd apps/dgfy-api && npm run check:architecture-guardrails && npm run check:controller-boundaries",
    "check:architecture:dgfy-api": "cd apps/dgfy-api && npm run check:architecture-guardrails && npm run check:controller-boundaries",
    "check:compliance": "node scripts/check-compliance-impact.js && node scripts/check-compliance-api-contracts.js",
    "check:tenant-schema-coverage": "cd apps/dgfy-api && npm run check:tenant-schema-coverage",
    "check:pos-receipt-version": "node scripts/check-pos-receipt-version-bump.js",
    "prepare": "node -e \"if(process.env.NODE_ENV!=='production')try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "kill:dev": "bash scripts/kill-dev.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:auto": "bash scripts/deploy.sh --auto",
    "deploy:verify": "bash scripts/deploy.sh --auto --verify",
    "deploy:prod:ci": "bash scripts/deploy-production-ci.sh",
    "promote:staging-to-master": "node scripts/promote-staging-to-master.js",
    "review:deployed-change-accuracy": "node scripts/review-deployed-change-accuracy.js",
    "audit:master-promotion": "node scripts/audit-master-promotion.js",
    "audit:mode-rbac-users": "cd apps/dgfy-api && npm run audit:mode-rbac-users --",
    "collect:master-promotion-evidence": "node scripts/collect-master-promotion-evidence.js",
    "collect:github-actions-unavailability": "node scripts/collect-github-actions-unavailability.js",
    "check:pr": "node scripts/pr-checks.js",
    "review:merged-branch-cleanup": "node scripts/review-merged-branch-cleanup.js",
    "build:release-candidate-evidence": "node scripts/build-release-candidate-evidence.js",
    "verify:prod:multi-location": "powershell -ExecutionPolicy Bypass -File scripts/verify-prod-multi-location.ps1",
    "verify:qa:multi-location": "powershell -ExecutionPolicy Bypass -File scripts/verify-qa-multi-location.ps1",
    "gate:release:prod-contracts": "npm run verify:prod:multi-location",
    "gate:release:qa-contracts": "npm run verify:qa:multi-location",
    "drill:qa:rollback": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-rollback-drill.ps1",
    "drill:qa:restore": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-restore-drill.ps1",
    "deploy:qa:target": "powershell -ExecutionPolicy Bypass -File scripts/deploy-qa-target.ps1",
    "evidence:qa:deploy-summary": "powershell -ExecutionPolicy Bypass -File scripts/fetch-qa-deploy-summary.ps1",
    "gate:release:no-staging:preflight": "node scripts/check-no-staging-prereqs.js",
    "gate:release:no-staging": "node scripts/gate-release-no-staging.js",
    "gate:release:no-staging:qa-env": "powershell -ExecutionPolicy Bypass -File scripts/run-qa-release-gate.ps1",
    "gate:release:prod-contracts:env": "powershell -ExecutionPolicy Bypass -File scripts/run-prod-contract-gate.ps1",
    "gate:release:observability": "node scripts/gate-release-observability.js",
    "gate:release:local": "node scripts/gate-release-local.js",
    "gate:release:dgfy-evidence": "node scripts/gate-release-dgfy-evidence.js",
    "check:dgfy-seam-smoke": "node scripts/dgfy-seam-smoke.js",
    "test:dgfy-release-evidence": "node --test scripts/gate-release-dgfy-evidence.test.js",
    "record:frontend-build-manifest": "node scripts/record-frontend-build-manifest.js",
    "uat:production:dgfy": "node scripts/run-dgfy-production-uat.js",
    "verify:release-verdict": "node scripts/verify-release-verdict.js",
    "verify:production-deploy-contract": "node scripts/verify-production-deploy-contract.js",
    "test:deploy-contract": "node scripts/check-deploy-source-contract.test.js && node scripts/check-no-staging-prereqs.test.js && node scripts/verify-production-deploy-contract.test.js",
    "test:merge-adoption": "node scripts/check-merge-adoption.test.js && node scripts/check-merge-adoption-required.test.js && node scripts/check-merge-hygiene.test.js",
    "test:development-to-production": "node scripts/check-batch-inventory.test.js && node scripts/check-documentation-closure.test.js && node scripts/validate-batch-inventory.test.js && node scripts/check-regression-risk.test.js && node scripts/check-qa-target-proof.test.js && node scripts/audit-master-promotion.test.js && node scripts/review-deployed-change-accuracy.test.js && node scripts/collect-github-actions-unavailability.test.js && node scripts/pr-checks.test.js && node scripts/build-release-candidate-evidence.test.js && node scripts/find-reviewed-batch-manifest.test.js && node scripts/deploy-master-ci.test.js && node scripts/review-merged-branch-cleanup.test.js",
    "test:release-controller": "node --test release-controller/test/*.test.js"
  },
  "keywords": [
    "inventory",
    "management",
    "sku",
    "fifo",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
