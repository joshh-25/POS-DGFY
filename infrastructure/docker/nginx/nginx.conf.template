# Host-based reverse proxy for the SKUpervisor / POS / Storefront domains,
# all pointing at this server's IP. Domain names are parameterized via
# environment variables (see docker-compose.yml's nginx.environment block
# and .env.example) so the SAME template serves DEV/QA/PROD/beta with just
# different values -- no per-environment nginx image or config file.
#
# This is a stock `nginx:alpine` image (not a custom-built one): this file
# is mounted at /etc/nginx/templates/default.conf.template, and the
# official image's built-in docker-entrypoint.d/20-envsubst-on-templates.sh
# runs `envsubst` against it automatically on container start, restricted
# to names that are actually set as container environment variables --
# nginx's own runtime variables ($host, $scheme, $remote_addr, etc.) are
# never OS env vars, so they pass through untouched. Output lands at
# /etc/nginx/conf.d/default.conf.
#
# Unlike the earlier custom-baked nginx image (infrastructure/docker/nginx/
# conf.d/*.conf, now removed), this outer layer does the /api, /uploads,
# and /openfreemap proxying itself -- the `frontend` service behind it is
# pure static-file serving on 3 internal ports (8081/8082/8083), one image
# for all three SPAs (see infrastructure/docker/frontend/Dockerfile).
#
# TLS is provided by Let's Encrypt via the `certbot` service in
# docker-compose.yml. See init-letsencrypt.sh for the one-time bootstrap
# needed before this config's `ssl_certificate` paths exist.
#
# Every proxy_pass target below uses `set $var host:port; proxy_pass
# http://$var;` instead of a bare `proxy_pass http://host:port;`. This is
# NOT cosmetic: a bare proxy_pass resolves the hostname ONCE per nginx
# worker (at startup/reload) and never again, but `backend`/`frontend`
# get a NEW internal IP every time docker-compose recreates them (e.g. on
# every deploy). Without this, nginx keeps proxying to the old, dead IP
# after every deploy until it happens to be reloaded/restarted for some
# other reason -- a "502 Bad Gateway" that only a manual `nginx -s reload`
# fixes. Routing through a variable forces nginx to actually consult the
# `resolver` directive (Docker's embedded DNS) on each connection.
#
# Production and beta share this single container: the beta domain group
# below proxies to the `frontend-beta` service, the PRODUCTION domain group
# further down proxies to `frontend` -- both share the same `backend`.

resolver 127.0.0.11 valid=10s;

# Root-owned provisioning tooling writes one validated server block per active
# custom storefront. The web application has read-only registry access and never
# receives filesystem, certificate, Docker, or reload privileges.
include /etc/nginx/custom-storefronts/*.conf;

# Reject requests with an unrecognized Host header (direct-IP hits, scans)
# instead of silently falling through to whichever server block nginx
# picks by default.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;
    return 444;
}

# Plain HTTP: serve ACME HTTP-01 challenges (needed for both initial
# issuance and renewal), redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${SKUPERVISOR_DOMAIN} ${POS_DOMAIN} ${STOREFRONT_DOMAIN} ${STOREFRONT_ALT_DOMAIN} ${SKUPERVISOR_DOMAIN_PROD} ${POS_DOMAIN_PROD} ${STOREFRONT_DOMAIN_PROD};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${SKUPERVISOR_DOMAIN};
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    location /api {
        set $backend_upstream backend:5000;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /uploads {
        set $backend_upstream backend:5000;
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin PostHog (EU cloud) proxy -- see
    # frontend/src/observability/analyticsClient.js and
    # docs/ops/STAGE_CONNECTION_EXHAUSTION_AND_CSP_INCIDENT_2026-07-27.md.
    # posthog-js's core chunk is bundled and same-origin, but it lazily
    # fetches session-replay/surveys/web-vitals/dead-clicks from
    # eu-assets.i.posthog.com and remote config from /array/ at runtime --
    # both blocked by the storefront's strict `script-src 'self' blob:` CSP.
    # Proxying them under /ingest/ makes them 'self' too, so the CSP needs no
    # loosening. Three locations, matching PostHog's own nginx recipe: static
    # assets and remote config share the *-assets host, everything else
    # (event capture, feature flags, session recording ingest) goes to the
    # regional API host.
    location /ingest/static/ {
        set $posthog_assets_upstream eu-assets.i.posthog.com;
        rewrite ^/ingest/static/(.*)$ /static/$1 break;
        proxy_pass https://$posthog_assets_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $posthog_assets_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ingest/array/ {
        set $posthog_assets_upstream eu-assets.i.posthog.com;
        rewrite ^/ingest/array/(.*)$ /array/$1 break;
        proxy_pass https://$posthog_assets_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $posthog_assets_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ingest/ {
        set $posthog_upstream eu.i.posthog.com;
        rewrite ^/ingest/(.*)$ /$1 break;
        proxy_pass https://$posthog_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $posthog_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin OpenFreeMap tile proxy -- see
    # frontend/src/components/maps/mapLibreShared.js. In the old PM2/
    # vite-preview production topology this was handled by Vite's own
    # preview-server proxy, not nginx; replicated here since the frontend
    # container is static-only.
    location /openfreemap/ {
        set $openfreemap_upstream tiles.openfreemap.org;
        rewrite ^/openfreemap/(.*)$ /$1 break;
        proxy_pass https://$openfreemap_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $openfreemap_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend_upstream frontend-beta:8081;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

