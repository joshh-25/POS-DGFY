# Host-based reverse proxy for the SKUpervisor / POS / Storefront domains,
# all pointing at this server's IP. Domain names are parameterized via
# environment variables (see docker-compose.yml's nginx.environment block
# and .env.example) so the SAME template serves DEV/QA/PROD/beta with just
# different values -- no per-environment nginx image or config file.
#
# This is a stock `nginx:alpine` image (not a custom-built one): this file
# is mounted at /etc/nginx/templates/default.conf.template, and the
# official image's built-in docker-entrypoint.d/20-envsubst-on-templates.sh
# runs `envsubst` against it automatically on container start, restricted
# to names that are actually set as container environment variables --
# nginx's own runtime variables ($host, $scheme, $remote_addr, etc.) are
# never OS env vars, so they pass through untouched. Output lands at
# /etc/nginx/conf.d/default.conf.
#
# Unlike the earlier custom-baked nginx image (infrastructure/docker/nginx/
# conf.d/*.conf, now removed), this outer layer does the /api, /uploads,
# and /openfreemap proxying itself -- each of `dgfy-ims`/`dgfy-pos`/
# `dgfy-storefront` behind it is pure static-file serving on its own
# internal port (8081/8082/8083 respectively), one image per app (issue
# #322 Phase 6 -- see infrastructure/docker/dgfy-{ims,pos,storefront}/Dockerfile;
# previously one shared image, infrastructure/docker/frontend/Dockerfile,
# now removed).
#
# TLS is provided by Let's Encrypt via the `certbot` service in
# docker-compose.yml. See init-letsencrypt.sh for the one-time bootstrap
# needed before this config's `ssl_certificate` paths exist.
#
# Every proxy_pass target below uses `set $var host:port; proxy_pass
# http://$var;` instead of a bare `proxy_pass http://host:port;`. This is
# NOT cosmetic: a bare proxy_pass resolves the hostname ONCE per nginx
# worker (at startup/reload) and never again, but `dgfy-api`/`dgfy-ims`/
# `dgfy-pos`/`dgfy-storefront` get a NEW internal IP every time
# docker-compose recreates them (e.g. on every deploy). Without this, nginx
# keeps proxying to the old, dead IP after every deploy until it happens to
# be reloaded/restarted for some other reason -- a "502 Bad Gateway" that
# only a manual `nginx -s reload` fixes. Routing through a variable forces
# nginx to actually consult the `resolver` directive (Docker's embedded
# DNS) on each connection.
#
# Beta retired (#329, 2026-08-23): the beta domain group below is redirect-only
# -- three bare `return 301` blocks with no upstream, terminating TLS on the
# still-live beta cert lineage so previously-generated absolute URLs (printed
# QR codes, bookmarks) land on the equivalent prod resource. The PRODUCTION
# domain group further down still proxies to `dgfy-{ims,pos,storefront}` +
# the shared `dgfy-api`.

# ipv6=off: this resolver also serves the runtime-resolved external
# upstreams below (PostHog /ingest/, OpenFreeMap /openfreemap/). Docker's
# embedded DNS returns AAAA records for those hostnames, but the
# dgfy_internal bridge network has no IPv6 egress -- without ipv6=off nginx
# picks the AAAA record and every request fails with "connect() ... failed
# (101: Network unreachable)" (#431).
resolver 127.0.0.11 valid=10s ipv6=off;

# Root-owned provisioning tooling writes one validated server block per active
# custom storefront. The web application has read-only registry access and never
# receives filesystem, certificate, Docker, or reload privileges.
include /etc/nginx/custom-storefronts/*.conf;

# Reject requests with an unrecognized Host header (direct-IP hits, scans)
# instead of silently falling through to whichever server block nginx
# picks by default.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;
    return 444;
}

# Plain HTTP: serve ACME HTTP-01 challenges (needed for both initial
# issuance and renewal), redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${SKUPERVISOR_DOMAIN} ${POS_DOMAIN} ${STOREFRONT_DOMAIN} ${STOREFRONT_ALT_DOMAIN} ${DGFY_API_DOMAIN} ${DGLAUNDRY_DOMAIN} ${SKUPERVISOR_DOMAIN_PROD} ${POS_DOMAIN_PROD} ${STOREFRONT_DOMAIN_PROD};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DGFY_API_DOMAIN};
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    location / {
        set $dgfy_api_upstream dgfy-api:5100;
        proxy_pass http://$dgfy_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# Staff operations are hosted by DGLaundry but terminate at this shared edge.
# The nginx container reaches the gateway through dgfy-dglaundry-edge only;
# DGLaundry's application/database network is never joined by DGFY services.
server {
    listen 443 ssl;
    server_name ${DGLAUNDRY_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN_PROD}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN_PROD}/privkey.pem;

    location / {
        set $dglaundry_gateway_upstream ${DGLAUNDRY_GATEWAY_HOST}:${DGLAUNDRY_GATEWAY_PORT};
        proxy_pass http://$dglaundry_gateway_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

server {
    listen 443 ssl;
    server_name ${SKUPERVISOR_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    return 301 https://${SKUPERVISOR_DOMAIN_PROD}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${POS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    return 301 https://${POS_DOMAIN_PROD}$request_uri;
}

# Storefront redirect. Deliberately drops ${STOREFRONT_ALT_DOMAIN} (bar.space.com.ph)
# from server_name -- that hostname now resolves off DGFY infra entirely (DNS points
# elsewhere, its own cert expired 2026-08-07) and carrying it here would make this
# block claim a Host header it can no longer legitimately answer for. Tracked
# separately as #900; not a dependency of this redirect.
server {
    listen 443 ssl;
    server_name ${STOREFRONT_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN}/privkey.pem;

    return 301 https://${STOREFRONT_DOMAIN_PROD}$request_uri;
}

# ============================================================================
# PRODUCTION domain group (dgfy.ph / skupervisor.dgfy.ph / pos.dgfy.ph).
# Serves the PROD `dgfy-{ims,pos,storefront}` containers (prod VITE_* baked
# in) via the separate ${CERT_DOMAIN_PROD} certificate. /api + /uploads
# proxy to the SAME shared `dgfy-api:5100` the beta redirects above also
# terminated on.
# ============================================================================

server {
    listen 443 ssl;
    server_name ${SKUPERVISOR_DOMAIN_PROD};
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/${CERT_DOMAIN_PROD}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_DOMAIN_PROD}/privkey.pem;

    location /api {
        # #1824: default proxy_read_timeout (60s) is shorter than tenant
        # approval/retry provisioning (~88s observed), which caused a spurious
        # 504 on a request that succeeded in the backend. 180s gives headroom
        # over the observed time. See the dedicated menu-import location below
        # for the same idiom on one specific endpoint.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        set $dgfy_api_upstream dgfy-api:5100;
        proxy_pass http://$dgfy_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Batch menu import upload -- a dedicated location rather than a global
    # client_max_body_size bump above, since this is the one endpoint that
    # intentionally accepts up to MENU_IMPORT_MAX_FILES_PER_BATCH PDFs/photos
    # in a single multipart request (~20 files x ~2MB post-compression budget
    # = ~40MB; 64m leaves headroom). proxy_read_timeout is raised too, though
    # in practice the upload use case only writes to Redis and returns a
    # job_id -- extraction itself runs asynchronously in
    # workers/menuImportWorker.js, not inline in this request.
    location = /api/v1/items/import/menu/jobs {
        set $dgfy_api_upstream dgfy-api:5100;
        client_max_body_size 64m;
        proxy_read_timeout 120s;
        proxy_pass http://$dgfy_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /uploads {
        set $dgfy_api_upstream dgfy-api:5100;
        proxy_pass http://$dgfy_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin PostHog (EU cloud) proxy -- see
    # packages/web-core/src/observability/analyticsClient.js and
    # docs/ops/STAGE_CONNECTION_EXHAUSTION_AND_CSP_INCIDENT_2026-07-27.md and
    # docs/ops/PRODUCTION_READINESS_POSTHOG_AND_NGINX_DRIFT.md. Same three
    # locations as the beta skupervisor/POS/storefront server blocks above.
    location /ingest/static/ {
        set $posthog_assets_upstream eu-assets.i.posthog.com;
        rewrite ^/ingest/static/(.*)$ /static/$1 break;
        proxy_pass https://$posthog_assets_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $posthog_assets_upstream;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $posthog_assets_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ingest/array/ {
        set $posthog_assets_upstream eu-assets.i.posthog.com;
        rewrite ^/ingest/array/(.*)$ /array/$1 break;
        proxy_pass https://$posthog_assets_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $posthog_assets_upstream;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $posthog_assets_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ingest/ {
        set $posthog_upstream eu.i.posthog.com;
        rewrite ^/ingest/(.*)$ /$1 break;
        proxy_pass https://$posthog_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $posthog_upstream;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $posthog_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openfreemap/ {
        set $openfreemap_upstream tiles.openfreemap.org;
        rewrite ^/openfreemap/(.*)$ /$1 break;
        proxy_pass https://$openfreemap_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $openfreemap_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend_upstream dgfy-ims:8081;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

