# storefront
server {
    listen 5175;

    location /api {
        set $api_upstream dgfy-api:5100;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https; # local dev: no real TLS, but dgfy-api's ENFORCE_HTTPS trusts this header from its reverse proxy
    }

    location /uploads {
        set $api_upstream dgfy-api:5100;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https; # local dev: no real TLS, but dgfy-api's ENFORCE_HTTPS trusts this header from its reverse proxy
    }

    location /openfreemap/ {
        set $openfreemap_upstream tiles.openfreemap.org;
        rewrite ^/openfreemap/(.*)$ /$1 break;
        proxy_pass https://$openfreemap_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $openfreemap_upstream;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /tenant-store {
        return 301 /tenant-store/;
    }

    location /tenant-store/ {
        set $frontend_upstream dgfy-storefront:8083;
        rewrite ^/tenant-store/(.*)$ /$1 break;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # #452: affiliate short-link alias. /s/{short_code} is a client-side SPA route -- the
    # storefront app reads the code out of window.location.pathname and resolves it via
    # GET /api/v1/dgfy/affiliate/s/{short_code}. nginx only has to hand it the app shell.
    #
    # No rewrite (unlike /tenant-store/ above): stripping the prefix would gain nothing --
    # the container's try_files falls through to /index.html either way -- and the browser
    # URL is untouched by a rewrite regardless, so the SPA sees /s/... in both cases.
    #
    # This block is functionally covered by `location /` today. It exists so the contract is
    # explicit: narrowing `location /` later must not silently break every printed QR code.
    location /s/ {
        set $frontend_upstream dgfy-storefront:8083;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        add_header Cache-Control "no-store";
    }

    location / {
        set $frontend_upstream dgfy-storefront:8083;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
