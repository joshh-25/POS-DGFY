# Copy to infrastructure/docker/.env on each server and replace every
# placeholder. Never commit the resulting .env file.
#
# NOTE: DB_HOST, DB_PORT, DB_DIALECT, REDIS_URL, and PORT are fixed to the
# in-network service names/ports directly in docker-compose.yml's `backend.
# environment:` block. Setting them here has no effect — they're listed as
# comments below purely for reference.
#
# This same compose file + these same images serve DEV/QA/PROD/beta -- only
# the values below (mainly the domain vars) differ per environment. Typical
# value sets:
#
#   PROD:  SKUPERVISOR_DOMAIN=skupervisor.dgfy.ph
#          POS_DOMAIN=pos.dgfy.ph
#          STOREFRONT_DOMAIN=dgfy.ph
#          STOREFRONT_ALT_DOMAIN=store.dgfy.ph
#          DGFY_API_DOMAIN=api.dgfy.ph
#          CERT_DOMAIN=dgfy.ph   (one multi-SAN cert covers all of the above)
#
#   beta:  SKUPERVISOR_DOMAIN=skupervisor.beta.dgfy.ph
#          POS_DOMAIN=pos.beta.dgfy.ph
#          STOREFRONT_DOMAIN=beta.dgfy.ph
#          STOREFRONT_ALT_DOMAIN=            (leave empty, no alt domain)
#          DGFY_API_DOMAIN=api.beta.dgfy.ph
#          CERT_DOMAIN=beta.dgfy.ph

# ==== Which build to run ====
# Pin to a git SHA or a released vX.Y.Z tag for reproducibility; `latest` is
# whatever most recently landed on master.
IMAGE_TAG=latest

# ==== Domains (nginx routing + Let's Encrypt) ====
# See nginx/nginx.conf.template and nginx/init-letsencrypt.sh. Changing
# these on an existing server requires re-running init-letsencrypt.sh to
# get a matching certificate before nginx will start.
SKUPERVISOR_DOMAIN=skupervisor.dgfy.ph
POS_DOMAIN=pos.dgfy.ph
STOREFRONT_DOMAIN=dgfy.ph
STOREFRONT_ALT_DOMAIN=store.dgfy.ph
DGFY_API_DOMAIN=api.dgfy.ph
CERT_DOMAIN=dgfy.ph
CERTBOT_EMAIL=replace_with_a_real_contact_email

# Custom Storefront DNS verification targets. Set the stable public edge IPv4,
# the approved CNAME target, or both. Admin verification fails closed if neither
# is configured.
CUSTOM_STOREFRONT_APEX_IPV4=replace_with_stable_edge_ipv4
# Leave empty until the DGFY edge has an approved, reachable IPv6 address.
CUSTOM_STOREFRONT_APEX_IPV6=
CUSTOM_STOREFRONT_CNAME_TARGET=custom-storefronts.dgfy.ph
STOREFRONT_RESERVED_HOSTNAMES=surebizcorp.com,store.surebizcorp.com
# Production stays fail-closed unless the feature and at least one pilot tenant
# UUID are explicitly configured.
CUSTOM_STOREFRONT_DOMAINS_ENABLED=false
CUSTOM_STOREFRONT_DOMAIN_PILOT_TENANT_IDS=
# Only enable if a trusted upstream overwrites (not appends) X-Forwarded-Host.
TRUST_FORWARDED_HOST_FOR_STOREFRONT_DOMAINS=false
# Generate with a secret manager; never commit the real controller token.
STOREFRONT_DOMAIN_CONTROLLER_TOKEN=replace_with_32_plus_character_secret
STOREFRONT_DOMAIN_CONTROLLER_ALLOWED_IPS=127.0.0.1
STOREFRONT_DOMAIN_CONTROLLER_ID=replace_with_controller_instance_id
STOREFRONT_DOMAIN_CONTROLLER_API_URL=https://api.dgfy.ph
STOREFRONT_DOMAIN_ACME_STAGING=true
STOREFRONT_DOMAIN_MAINTENANCE_ENABLED=false
STOREFRONT_DOMAIN_MAINTENANCE_INTERVAL_MS=21600000

# ==== MySQL ====
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=sku_inventory_manager
DB_USER=sku_inventory_user
DB_PASSWORD=change_me_db_password
# DB_HOST=mysql            (fixed in docker-compose.yml)
# DB_PORT=3306             (fixed in docker-compose.yml)
# DB_DIALECT=mysql         (fixed in docker-compose.yml)

# ==== Redis ====
# REDIS_URL=redis://redis:6379   (fixed in docker-compose.yml)

# ==== Backend core ====
NODE_ENV=production
HOSTING_PROFILE=vps
HOSTING_INSTANCE_COUNT=1
# PORT=5000               (fixed in docker-compose.yml)

JWT_SECRET=replace_with_64_char_random_jwt_secret
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace_with_different_64_char_random_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

# Not auto-derived from the SKUPERVISOR_DOMAIN/POS_DOMAIN/STOREFRONT_DOMAIN
# vars above on purpose (CORS needs the full https:// origin list, and this
# app's CORS policy has historically included extra legacy domains) -- keep
# this in sync with them by hand when changing domains.
CORS_ORIGIN=https://skupervisor.dgfy.ph,https://pos.dgfy.ph,https://dgfy.ph,https://store.dgfy.ph
PUBLIC_API_CORS_ORIGIN=https://mapviu.com,https://*.mapviu.com
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.dgfy.ph
TRUST_PROXY=true
ENFORCE_HTTPS=true

AUTH_BLACKLIST_FAILURE_MODE=fail_closed
TEMP_FILE_STORAGE=auto
# Disabled by default: this audit's health status can flip to "degraded"
# (-> /api/v1/health 503, which the backend container's HEALTHCHECK and
# nginx's depends_on: condition: service_healthy both key off) due to a
# pre-existing query error unrelated to Docker packaging, independent of
# whether payments are actually in use. Re-enable once billing/payments are
# live and the underlying audit query issue has been confirmed fixed.
BILLING_FUNNEL_AUDIT_ENABLED=false
STOREFRONT_DISCOVERY_REDIS_CACHE_ENABLED=true
CUSTOMER_ACCESS_MODES_ENABLED=true
TENANT_REGISTRATION_APPROVAL_MODE=auto_standard
PAYMENTS_ENABLED=false
DB_AUTO_SYNC=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_STORE_TRACKING_READ_WINDOW_MS=900000
RATE_LIMIT_STORE_TRACKING_READ_MAX_REQUESTS=300
RATE_LIMIT_DGFY_TENANT_SESSION_WINDOW_MS=900000
RATE_LIMIT_DGFY_TENANT_SESSION_MAX_REQUESTS=10
RATE_LIMIT_TENANT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_TENANT_REGISTRATION_MAX_REQUESTS=5

# ==== Email (SMTP + Brevo fallback) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_app_password
EMAIL_FROM=replace_with_sender_email
EMAIL_FROM_NAME=SKUpervisor
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_DELIVERY_FALLBACK_TO_BREVO_API=true
BREVO_API_KEY=replace_with_brevo_api_key_if_smtp_ports_are_blocked
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# ==== Backend public URLs ====
APP_URL=https://dgfy.ph
FRONTEND_URL=https://dgfy.ph

# ==== Sentry (backend runtime) ====
# There is no CI path for these -- deploy-backend.yml intentionally passes
# zero build-args, so this is the only place a server picks up its Sentry
# config. Set SENTRY_ENVIRONMENT explicitly on every server that enables
# this: NODE_ENV is fixed to "production" above for ALL environments
# (dev/staging/beta/prod alike), so leaving SENTRY_ENVIRONMENT unset would
# file this server's errors under environment "production" regardless of
# which box it actually is. See infrastructure/docker/SENTRY.md.
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Omit entirely for tracing-without-performance (trace ids still propagate
# and still land on error events; zero transactions billed). A literal 0
# is NOT the same as omitting this -- see SENTRY.md's tracing-modes table.
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_DEBUG=false
