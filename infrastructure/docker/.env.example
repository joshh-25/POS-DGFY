# Copy to infrastructure/docker/.env on each server and replace every
# placeholder. Never commit the resulting .env file.
#
# NOTE: DB_HOST, DB_PORT, DB_DIALECT, REDIS_URL, and PORT are fixed to the
# in-network service names/ports directly in docker-compose.yml's `backend.
# environment:` block. Setting them here has no effect — they're listed as
# comments below purely for reference.

# ==== Which build to run ====
# Pin to a git SHA or a released vX.Y.Z tag for reproducibility; `latest` is
# whatever most recently landed on master.
IMAGE_TAG=latest

# ==== MySQL ====
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_NAME=sku_inventory_manager
DB_USER=sku_inventory_user
DB_PASSWORD=change_me_db_password
# DB_HOST=mysql            (fixed in docker-compose.yml)
# DB_PORT=3306             (fixed in docker-compose.yml)
# DB_DIALECT=mysql         (fixed in docker-compose.yml)

# ==== Redis ====
# REDIS_URL=redis://redis:6379   (fixed in docker-compose.yml)

# ==== Backend core ====
NODE_ENV=production
HOSTING_PROFILE=vps
HOSTING_INSTANCE_COUNT=1
# PORT=5000               (fixed in docker-compose.yml)

JWT_SECRET=replace_with_64_char_random_jwt_secret
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=replace_with_different_64_char_random_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

CORS_ORIGIN=https://skupervisor.dgfy.ph,https://pos.dgfy.ph,https://dgfy.ph,https://store.dgfy.ph
PUBLIC_API_CORS_ORIGIN=https://mapviu.com,https://*.mapviu.com
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.dgfy.ph
TRUST_PROXY=true
ENFORCE_HTTPS=true

AUTH_BLACKLIST_FAILURE_MODE=fail_closed
TEMP_FILE_STORAGE=auto
# Disabled by default: this audit's health status can flip to "degraded"
# (-> /api/v1/health 503, which the backend container's HEALTHCHECK and
# nginx's depends_on: condition: service_healthy both key off) due to a
# pre-existing query error unrelated to Docker packaging, independent of
# whether payments are actually in use. Re-enable once billing/payments are
# live and the underlying audit query issue has been confirmed fixed.
BILLING_FUNNEL_AUDIT_ENABLED=false
STOREFRONT_DISCOVERY_REDIS_CACHE_ENABLED=true
CUSTOMER_ACCESS_MODES_ENABLED=true
TENANT_REGISTRATION_APPROVAL_MODE=auto_standard
PAYMENTS_ENABLED=false
DB_AUTO_SYNC=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5
RATE_LIMIT_STORE_TRACKING_READ_WINDOW_MS=900000
RATE_LIMIT_STORE_TRACKING_READ_MAX_REQUESTS=300
RATE_LIMIT_DGFY_TENANT_SESSION_WINDOW_MS=900000
RATE_LIMIT_DGFY_TENANT_SESSION_MAX_REQUESTS=10
RATE_LIMIT_TENANT_REGISTRATION_WINDOW_MS=3600000
RATE_LIMIT_TENANT_REGISTRATION_MAX_REQUESTS=5

# ==== Email (SMTP + Brevo fallback) ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_app_password
EMAIL_FROM=replace_with_sender_email
EMAIL_FROM_NAME=SKUpervisor
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_DELIVERY_FALLBACK_TO_BREVO_API=true
BREVO_API_KEY=replace_with_brevo_api_key_if_smtp_ports_are_blocked
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# ==== Backend public URLs ====
APP_URL=https://dgfy.ph
FRONTEND_URL=https://dgfy.ph
