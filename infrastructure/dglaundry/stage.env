# Non-secret config for DGLaundry's staging stack on sieitz-dgfy-remote
# (/opt/dglaundry-stage). Secrets live in Sieitzz/dgfy-secrets under
# stage/dglaundry/secrets.env (SOPS-encrypted) -- never in this file.
#
# Image digests and release SHA per the accepted DGLaundry release handoff:
# https://github.com/Sieitzz/dgfy-platform/issues/519#issuecomment-6096072158
DGLAUNDRY_RELEASE_SHA=391ba15e8cfd82c289a2fc3e3fdd45756a981b17
DGLAUNDRY_API_IMAGE=ghcr.io/sieitzz/dglaundry-api@sha256:951c095eb0ee5a56aafce4b7f71d7f8dce331c049f0c47f61ddc7ca4e2e0208d
DGLAUNDRY_WEB_IMAGE=ghcr.io/sieitzz/dglaundry-web@sha256:f17756cb2c2ee1bb544b661a5f6d2d5b1459d4c5fda8838538939d2e37b300c3
DGLAUNDRY_WORKER_IMAGE=ghcr.io/sieitzz/dglaundry-worker@sha256:a62ea95764db26d8e5cf7ea47488bd1978fcc17065fa03dfe3d236131da23ad6
DGLAUNDRY_MYSQL_IMAGE=mysql:8.0

# This is a self-consistency guard, not a secret or a cross-team
# coordination point: dglaundry's own mysqlPersistence.ts compares this
# value against whatever migration-manifest.json's "head" field says
# inside the running image, purely to catch a stale/mismatched image at
# boot. Derived directly from the pinned release SHA's own manifest
# (git show 391ba15e8...:apps/api/src/migrations/migration-manifest.json),
# not asked of DGLaundry -- same value as legacy's older SHA, since no new
# migrations landed between the two releases.
DGLAUNDRY_MIGRATION_REQUIRED_HEAD=075_mock_provider_credentials.sql

DGLAUNDRY_PUBLIC_ORIGIN=https://dglaundry.stage.dgfy.ph
DGLAUNDRY_DGFY_REDIRECT_URI=https://dglaundry.stage.dgfy.ph/api/v1/session/dgfy/callback

# Stays disabled (same as DGLaundry's current legacy deployment) until #2304's
# registration amendment and DGFY's own OIDC signing keys are live. Flipping
# this to "production" additionally requires layering
# docker-compose.production.dgfy.yml (DGLaundry's own repo) on top of the
# base compose at deploy time -- not wired into deploy-sops.sh yet.
DGLAUNDRY_DGFY_MODE=disabled

# TODO (blocked on DGFY's own OIDC key material, #2304): DGFY's public
# request/event signing keys, which DGLaundry needs to verify incoming
# DGFY-signed requests. Required by the base compose (api service) even in
# disabled mode -- {} is a safe non-empty placeholder, NOT a real value.
DGLAUNDRY_INTEGRATION_PUBLIC_KEYS_JSON={}

# Functionally inert on staging: nginx reaches the gateway via the
# published loopback port below, not via this Docker network (staging has
# no containerized reverse proxy -- see infrastructure/nginx-host/'s own
# header comment). Kept so the compose file's `external: true` network
# requirement is satisfied; on prod, where the containerized proxy
# (docker-compose.proxy.yml) *is* used, this same network name is the real
# routing path.
DGLAUNDRY_EDGE_NETWORK=dgfy-dglaundry-edge
DGLAUNDRY_EGRESS_NETWORK=dglaundry-stage-egress

# Free loopback port confirmed on sieitz-dgfy-remote 2026-10-12 (5000/6000,
# 8081-8085, 9081-9085 are already taken by dgfy-dev/dgfy-stage).
DGLAUNDRY_GATEWAY_PORT=4410

# Lean resource profile -- same values as DGLaundry's own
# docker-compose.surebizcorp-lean.yml, proven safe on an even smaller
# (~1.6GB free) host. sieitz-dgfy-remote has ~3GB free but runs dgfy-dev +
# dgfy-stage side by side already; do not raise these without re-checking
# `free -h` first.
DGLAUNDRY_MYSQL_MEM_LIMIT=512m
DGLAUNDRY_MYSQL_CPUS=1.0
DGLAUNDRY_MIGRATE_MEM_LIMIT=256m
DGLAUNDRY_MIGRATE_CPUS=0.5
DGLAUNDRY_API_MEM_LIMIT=384m
DGLAUNDRY_API_CPUS=0.75
DGLAUNDRY_WORKER_MEM_LIMIT=192m
DGLAUNDRY_WORKER_CPUS=0.5
DGLAUNDRY_GATEWAY_MEM_LIMIT=64m
DGLAUNDRY_GATEWAY_CPUS=0.25
DGLAUNDRY_MYSQL_MAX_CONNECTIONS=30

# Host-side paths and identity (/opt/dglaundry-stage/*, already prepared).
DGLAUNDRY_SECRETS_DIR=/opt/dglaundry-stage/secrets
DGLAUNDRY_SECRETS_GID=987
