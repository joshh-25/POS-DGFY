# Non-secret config for DGLaundry's staging stack on sieitz-dgfy-remote
# (/opt/dglaundry-stage). Secrets live in Sieitzz/dgfy-secrets under
# stage/dglaundry/secrets.env (SOPS-encrypted) -- never in this file.
#
# Image digests and release SHA per the accepted DGLaundry release handoff:
# https://github.com/Sieitzz/dgfy-platform/issues/519#issuecomment-6207152617
DGLAUNDRY_RELEASE_SHA=027f90a04c9b4280f34a688b3280de5fc185b65f
DGLAUNDRY_API_IMAGE=ghcr.io/sieitzz/dglaundry-api@sha256:c891ad8845a643c1b70af6550b2a52c466f35cb9f6f7de1312a6fb072dc9de4b
DGLAUNDRY_WEB_IMAGE=ghcr.io/sieitzz/dglaundry-web@sha256:4ff765d1a58d6caf63a17736c8b81d03f5047ae772ed3b1e63c1ca99c0ec2ad1
DGLAUNDRY_WORKER_IMAGE=ghcr.io/sieitzz/dglaundry-worker@sha256:802d610678fe8a7d9ef6248a20fbb0e509d983670063ddf4e5f35e3e9f88c1f9
DGLAUNDRY_MYSQL_IMAGE=mysql:8.0

# This is a self-consistency guard, not a secret or a cross-team
# coordination point: dglaundry's own mysqlPersistence.ts compares this
# value against whatever migration-manifest.json's "head" field says
# inside the running image, purely to catch a stale/mismatched image at
# boot. Derived directly from the pinned release SHA's own manifest
# (git show 391ba15e8...:apps/api/src/migrations/migration-manifest.json),
# not asked of DGLaundry -- same value as legacy's older SHA, since no new
# migrations landed between the two releases.
DGLAUNDRY_MIGRATION_REQUIRED_HEAD=076_demo_control.sql

DGLAUNDRY_PUBLIC_ORIGIN=https://dglaundry.stage.dgfy.ph
DGLAUNDRY_DGFY_REDIRECT_URI=https://dglaundry.stage.dgfy.ph/api/v1/session/dgfy/callback

# DGFY connection (#2304). "sandbox" is the staging value (the installer's
# manifest maps paymentMode "sandbox" -> sandbox; prod uses "production").
# Anything but "disabled" makes remote-deploy.sh layer
# docker-compose.production.dgfy.yml (and, for sandbox only, the lean qualification
# overlay that sets DEPLOYMENT_ENV=qualification -- the app refuses sandbox otherwise), which REQUIRES the five DGFY secret files
# below to exist (deploy-sops.sh writes them from stage/dglaundry/secrets.env)
# plus every DGLAUNDRY_DGFY_* variable in this section.
DGLAUNDRY_DGFY_MODE=sandbox

# The base compose defaults all of these to PRODUCTION (api.dgfy.ph) -- staging
# must point at staging DGFY. (Staging previously ran with the prod issuer
# default, inert only because the mode was disabled.)
DGLAUNDRY_DGFY_ISSUER=https://api.stage.dgfy.ph/oidc
DGLAUNDRY_DGFY_SESSION_CONTEXT_URL=https://api.stage.dgfy.ph/api/v1/partners/dglaundry/session-context
DGLAUNDRY_DGFY_REGISTRATION_INTENT_URL=https://api.stage.dgfy.ph/api/v1/partners/dglaundry/registration-intents
DGLAUNDRY_DGFY_STAFF_INVITATION_URL=https://api.stage.dgfy.ph/api/v1/partners/dglaundry/staff-invitation-intents
DGLAUNDRY_DGFY_LOCATION_INTENT_URL=https://api.stage.dgfy.ph/api/v1/partners/dglaundry/location-intents
DGLAUNDRY_DGFY_PARTNER_TOKEN_URL=https://api.stage.dgfy.ph/oidc/token

# Registered identities and key IDs (#2304 registration decision; mirrors
# docs/integrations/dglaundry-connection-manifest.json environments.staging).
DGLAUNDRY_DGFY_CLIENT_ID=dglaundry-web
DGLAUNDRY_DGFY_PARTNER_APP_ID=dglaundry
DGLAUNDRY_DGFY_PARTNER_CLIENT_ID=dglaundry-machine
DGLAUNDRY_DGFY_PARTNER_CLIENT_ASSERTION_KEY_ID=dglaundry-machine-stage-rs256
DGLAUNDRY_DGFY_PARTNER_SIGNING_KEY_ID=dglaundry-request-stage-p256

# DGFY's PUBLIC verification keys (public halves only, derived from the live
# staging key files; fingerprints sha256 of SPKI DER:
#   dgfy-request-stage-p256   91b909017a017609581654a1c9282f89d5a303816b4b9a7d2ad6ea2eddca82c8
#   dgfy-event-stage-ed25519  2ded6c6166ac728fa85e7e7f16f54b944d1472df68364574fa8d1eaa1826ee85
# ). Single-quoted so compose keeps the JSON's \n escapes literal.
DGLAUNDRY_DGFY_PARTNER_PUBLIC_KEYS_JSON='{"dgfy-request-stage-p256":"-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEcqn5HLxzGBOdwA/KKsBKTeOoDOn7\nwYuXXtiHAeFwQ43i9KfFDSduS+oFdONGQe+EdU7dtmjUEnRTOSIMZLggrQ==\n-----END PUBLIC KEY-----\n"}'
DGLAUNDRY_INTEGRATION_PUBLIC_KEYS_JSON='{"dgfy-event-stage-ed25519":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAvWx3EIdgDikN3zrHYP8Vo4HeGCtfbFX8qs5RejYkkW4=\n-----END PUBLIC KEY-----\n"}'

# Self-reported production configuration revision (api service env
# DGLAUNDRY_CONFIG_REVISION) -- purely descriptive audit metadata, not a
# secret and not blocked on anything. Bump this string whenever this file's
# meaningfully-reviewed config actually changes.
DGLAUNDRY_CONFIG_REVISION=2026-10-16-stage-dgfy-4

# Inbound DGFY-service-token validation (api service: DGFY_PARTNER_INBOUND_*).
# AUDIENCE is this stack's own public origin; CLIENT_ID is the registered
# DGFY service client (#2304: dglaundry-service).
DGLAUNDRY_DGFY_PARTNER_INBOUND_AUDIENCE=https://dglaundry.stage.dgfy.ph
DGLAUNDRY_DGFY_PARTNER_INBOUND_CLIENT_ID=dglaundry-service

# Functionally inert on staging: nginx reaches the gateway via the
# published loopback port below, not via this Docker network (staging has
# no containerized reverse proxy -- see infrastructure/nginx-host/'s own
# header comment). Kept so the compose file's `external: true` network
# requirement is satisfied; on prod, where the containerized proxy
# (docker-compose.proxy.yml) *is* used, this same network name is the real
# routing path.
DGLAUNDRY_EDGE_NETWORK=dgfy-dglaundry-edge
DGLAUNDRY_EGRESS_NETWORK=dglaundry-stage-egress

# Free loopback port confirmed on sieitz-dgfy-remote 2026-10-12 (5000/6000,
# 8081-8085, 9081-9085 are already taken by dgfy-dev/dgfy-stage).
DGLAUNDRY_GATEWAY_PORT=4410

# Lean resource profile. DGLaundry's docker-compose.production.yml already
# reads these exact variable names directly on each service's own mem_limit/
# cpus fields (e.g. `mem_limit: ${DGLAUNDRY_MYSQL_MEM_LIMIT:-1g}`) -- no
# docker-compose.surebizcorp-lean.yml overlay needed to apply them. That
# overlay was deliberately NOT vendored/layered here: it was written for
# Surebizcorp's own closed qualification and additionally requires several
# live DGFY integration vars (DGLAUNDRY_DGFY_CLIENT_ID, _ISSUER, etc.) that
# don't exist while DGLAUNDRY_DGFY_MODE=disabled, which made `docker compose
# config` fail outright when it was layered in (caught in PR #2448 review).
# Values below match the lean overlay's own hardcoded numbers, proven safe
# on an even smaller (~1.6GB free) host. sieitz-dgfy-remote has ~3GB free but
# runs dgfy-dev + dgfy-stage side by side already; do not raise these
# without re-checking `free -h` first.
DGLAUNDRY_MYSQL_MEM_LIMIT=512m
DGLAUNDRY_MYSQL_CPUS=1.0
DGLAUNDRY_MIGRATE_MEM_LIMIT=256m
DGLAUNDRY_MIGRATE_CPUS=0.5
DGLAUNDRY_API_MEM_LIMIT=384m
DGLAUNDRY_API_CPUS=0.75
DGLAUNDRY_WORKER_MEM_LIMIT=192m
DGLAUNDRY_WORKER_CPUS=0.5
DGLAUNDRY_GATEWAY_MEM_LIMIT=64m
DGLAUNDRY_GATEWAY_CPUS=0.25
DGLAUNDRY_MYSQL_MAX_CONNECTIONS=30

# Host-side paths and identity (/opt/dglaundry-stage/*, already prepared).
DGLAUNDRY_SECRETS_DIR=/opt/dglaundry-stage/secrets
# Still read by the vendored compose file's migrate/api/worker `group_add`
# directives (an alternative, upstream-provided access path: grant this GID
# as a supplementary group so a group-readable 640 secret file would be
# readable by them without matching any container's own UID). Not what
# actually gates access here -- deploy-sops.sh now writes secret files 644
# (world-readable within a 0700 directory, see its own comment), so this
# grant is harmless but not load-bearing. Left at its pre-existing value
# (987, the retired `dglaundry-secrets` host group's GID) rather than
# removed, since the vendored compose file can't be edited and still
# references it; not pursuing the group_add path itself, since it would
# require restoring per-app group ownership that PR #2452 deliberately
# retired in favor of one shared `sieitz` user (PR #2453 review, RF-3).
DGLAUNDRY_SECRETS_GID=987

# Monitoring-profile (otel-collector/prometheus/grafana/mysql-exporter/
# node-exporter/alertmanager) image digests. These services are gated behind
# `profiles: [monitoring]` and this host deliberately never passes
# `--profile monitoring` -- see infrastructure/docker/README.md in
# Sieitzz/dglaundry ("don't run monitoring here, existing Zabbix/SqlBak are
# used instead"). But Compose interpolates every service's `:?`-required
# variables at config-parse time regardless of which profile/service is
# actually targeted, so `docker compose pull mysql` fails outright without
# these present (caught in PR #2448 review, confirmed via `docker compose
# config`). These values are never resolved against a registry and never
# pulled -- any non-empty string satisfies the `:?` check.
DGLAUNDRY_OTEL_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_PROMETHEUS_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_GRAFANA_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_MYSQL_EXPORTER_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_NODE_EXPORTER_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_ALERTMANAGER_IMAGE=inert-monitoring-profile-not-used-on-this-host

# DGFY outbound events stay OFF: the worker requires DGFY_OUTBOUND_URL, KEY_ID and
# the signing key together or not at all, so DGLAUNDRY_DGFY_OUTBOUND_URL and
# DGLAUNDRY_DGFY_OUTBOUND_KEY_ID must BOTH stay unset until events are enabled
# (setting only the key ID crash-loops the worker -- seen on staging 2026-10-16).
