# Non-secret config for DGLaundry's production stack on the DGFY prod host
# (`ssh dgfy`, /opt/dglaundry). Secrets live in Sieitzz/dgfy-secrets under
# prod/dglaundry/secrets.env (SOPS-encrypted), never in this file.
#
# Pinned to the release deployed and verified on staging. The images were
# published by DGLaundry's self-hosted release builder at the exact source SHA.
# https://github.com/Sieitzz/dglaundry/actions/runs/40503847297
# https://github.com/Sieitzz/dgfy-platform/actions/runs/40506418983
DGLAUNDRY_RELEASE_SHA=c87eac464634a8504029b52c86ac3e958fd8505f
DGLAUNDRY_API_IMAGE=ghcr.io/sieitzz/dglaundry-api@sha256:9464610b5560e8a429a144cd221a40b7243cf02c4f74ca212b9c77036768f87a
DGLAUNDRY_WEB_IMAGE=ghcr.io/sieitzz/dglaundry-web@sha256:a1fd035d5b2198f31544ab0919532f41c620520ab4b7b8e170b5706478be269c
DGLAUNDRY_WORKER_IMAGE=ghcr.io/sieitzz/dglaundry-worker@sha256:30f7e1535461c1f64a9983261b8e8feecdc8c485b93058c64f217ac5c36bc0f6
DGLAUNDRY_MYSQL_IMAGE=mysql:8.0

# Self-consistency guard only (dglaundry's own mysqlPersistence.ts compares
# this against migration-manifest.json's "head" field inside the running
# image) -- same value as stage.env's, since this is the same pinned SHA.
DGLAUNDRY_MIGRATION_REQUIRED_HEAD=078_local_hardware.sql

DGLAUNDRY_PUBLIC_ORIGIN=https://dglaundry.dgfy.ph
DGLAUNDRY_DGFY_REDIRECT_URI=https://dglaundry.dgfy.ph/api/v1/session/dgfy/callback

# DGFY connection (#2304, #2834). Stays "disabled" until the DGFY staging
# qualification passes; flipping it to "production" is a separate,
# explicitly-authorized change. Every DGLAUNDRY_DGFY_* value below is already
# the real production value (DGFY's side went live on 2026-10-26: the
# connect-dgfy-prod.sh keys are in place and https://api.dgfy.ph/oidc/jwks is
# 200), so the flip is the one-line mode change plus a redeploy.
#
# Anything but "disabled" makes remote-deploy.sh layer
# docker-compose.production.dgfy.yml, which REQUIRES the five DGFY secret files
# (deploy-sops.sh writes them from prod/dglaundry/secrets.env, which
# connect-dgfy-prod.sh populated) plus every variable in this section.
DGLAUNDRY_DGFY_MODE=disabled

# The base compose defaults these to the production DGFY (api.dgfy.ph); they are
# pinned here so the production values are reviewed, not inherited.
DGLAUNDRY_DGFY_ISSUER=https://api.dgfy.ph/oidc
DGLAUNDRY_DGFY_SESSION_CONTEXT_URL=https://api.dgfy.ph/api/v1/partners/dglaundry/session-context
DGLAUNDRY_DGFY_REGISTRATION_INTENT_URL=https://api.dgfy.ph/api/v1/partners/dglaundry/registration-intents
DGLAUNDRY_DGFY_STAFF_INVITATION_URL=https://api.dgfy.ph/api/v1/partners/dglaundry/staff-invitation-intents
DGLAUNDRY_DGFY_LOCATION_INTENT_URL=https://api.dgfy.ph/api/v1/partners/dglaundry/location-intents
DGLAUNDRY_DGFY_PARTNER_TOKEN_URL=https://api.dgfy.ph/oidc/token

# Registered identities and key IDs (mirror
# docs/integrations/dglaundry-connection-manifest.json environments.production
# and DGFY's docker-compose.api.yml on the prod host).
DGLAUNDRY_DGFY_CLIENT_ID=dglaundry-web
DGLAUNDRY_DGFY_PARTNER_APP_ID=dglaundry
DGLAUNDRY_DGFY_PARTNER_CLIENT_ID=dglaundry-machine
DGLAUNDRY_DGFY_PARTNER_CLIENT_ASSERTION_KEY_ID=dglaundry-machine-prod-rs256
DGLAUNDRY_DGFY_PARTNER_SIGNING_KEY_ID=dglaundry-request-prod-p256

# DGFY's PUBLIC verification keys (public halves only, as printed by
# connect-dgfy-prod.sh; fingerprints sha256 of SPKI DER:
#   dgfy-request-prod-p256   3622e0680ad9aa32df97749a2902624b9ef1cf08ec63e6735d349bda1301de8b
#   dgfy-event-prod-ed25519  a0b83870917e87af0dad61cc038e94924f2280a125f729224fc2f721245264d1
# ). Single-quoted so compose keeps the JSON's \n escapes literal.
DGLAUNDRY_DGFY_PARTNER_PUBLIC_KEYS_JSON='{"dgfy-request-prod-p256":"-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEp1FlqHZW2nnf6avZjzyRQOzoyRe7\nIw8sAHeJvGak74Ezxx3fGVQZs7vQFQeocYuSHRYVh7mIwkHYPS0SPN9deQ==\n-----END PUBLIC KEY-----\n"}'
DGLAUNDRY_INTEGRATION_PUBLIC_KEYS_JSON='{"dgfy-event-prod-ed25519":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAeICB52YzjiiPrwplgjzREFg/ltuA6Q6CEJMC4hmjlyQ=\n-----END PUBLIC KEY-----\n"}'

# Self-reported production configuration revision (api service env
# DGLAUNDRY_CONFIG_REVISION) -- descriptive audit metadata only, bump
# whenever this file's meaningfully-reviewed config actually changes.
DGLAUNDRY_CONFIG_REVISION=2026-10-27-prod-4

# Inbound DGFY-service-token validation (api service: DGFY_PARTNER_INBOUND_*).
# AUDIENCE is this stack's own public origin; CLIENT_ID is the registered DGFY
# service client (dglaundry-service, DGFY_DGLAUNDRY_SERVICE_CLIENT_ID on prod).
DGLAUNDRY_DGFY_PARTNER_INBOUND_AUDIENCE=https://dglaundry.dgfy.ph
DGLAUNDRY_DGFY_PARTNER_INBOUND_CLIENT_ID=dglaundry-service

# On prod (unlike staging), this network is the REAL routing path: the
# containerized nginx proxy (docker-compose.proxy.yml) reaches the gateway
# through dgfy-dglaundry-edge, not the published loopback port below -- see
# README.md's "Prod: live-host edge-routing prerequisites" (applied to the
# live host for #2477).
#
# Both networks are `external: true` in the vendored compose file and must be
# pre-created on the host (README.md) -- a missing one fails the dispatch at
# `compose up`, after mysql is already running.
DGLAUNDRY_EDGE_NETWORK=dgfy-dglaundry-edge
DGLAUNDRY_EGRESS_NETWORK=dglaundry-prod-egress

# HOST-LOOPBACK publish only (127.0.0.1:4400 -> gateway:8080). NOT used by the
# prod nginx: that reaches the gateway container-to-container over the edge
# network on port 8080, set separately as the nginx service's own
# DGLAUNDRY_GATEWAY_PORT in docker-compose.proxy.yml. Two same-named vars,
# two unrelated meanings -- do not "sync" them.
DGLAUNDRY_GATEWAY_PORT=4400

# Shrunk well below staging's already-lean profile -- the prod host's own
# live memory is far tighter (confirmed 848Mi free, swap already 100% used,
# before anything new is added; see infra/2477 and ADR/epic #2387's own
# still-open "prod memory sizing pass" item). Concurrent peak with these
# values is ~608MB (mysql+api+worker+gateway; migrate is transient and
# exits before api/worker/gateway start), not ~1.4GB like staging's. The
# deploy workflow's own pre-flight step is the real safety net here, not
# these numbers alone -- do not raise them without re-checking `free -h`
# on the host first, and treat a VM memory/swap increase as the real fix
# this is only mitigating.
DGLAUNDRY_MYSQL_MEM_LIMIT=256m
DGLAUNDRY_MYSQL_CPUS=0.5
DGLAUNDRY_MIGRATE_MEM_LIMIT=128m
DGLAUNDRY_MIGRATE_CPUS=0.25
DGLAUNDRY_API_MEM_LIMIT=192m
DGLAUNDRY_API_CPUS=0.5
DGLAUNDRY_WORKER_MEM_LIMIT=128m
DGLAUNDRY_WORKER_CPUS=0.25
DGLAUNDRY_GATEWAY_MEM_LIMIT=32m
DGLAUNDRY_GATEWAY_CPUS=0.15
# Checked against the vendored compose file (compose/391ba15e8.../
# docker-compose.production.yml): the mysql service's `command:` only
# overrides --max_connections and --skip-name-resolve -- there is no
# innodb-buffer-pool-size override hook, and that vendored file must stay a
# byte-exact copy of the pinned SHA (never edited in place, see README.md),
# so an DGLAUNDRY_MYSQL_INNODB_BUFFER_POOL_SIZE-style var here would be
# silently inert. mysqld 8.0's own default innodb_buffer_pool_size (128M)
# leaves real but not generous headroom under the 256m cgroup cap once
# connection buffers/thread stacks are counted -- if mysqld gets OOM-killed
# in practice, the lever that actually works is raising
# DGLAUNDRY_MYSQL_MEM_LIMIT above (mem_limit is read directly by the
# vendored file), not trying to shrink the buffer pool from here.
DGLAUNDRY_MYSQL_MAX_CONNECTIONS=20

# Host-side paths and identity (/opt/dglaundry/*, no "-prod" suffix -- this
# host runs exactly one DGLaundry environment, matching /opt/dgfy-platform
# having no suffix here either; see README.md).
DGLAUNDRY_SECRETS_DIR=/opt/dglaundry/secrets
# See stage.env's own comment -- harmless, not load-bearing (deploy-sops.sh
# writes 644 files inside a 0700 directory), kept only because the vendored
# compose file's group_add directives reference it. No dedicated prod group
# exists or is needed; left at the same placeholder GID stage.env uses.
DGLAUNDRY_SECRETS_GID=987

# Monitoring-profile placeholders -- never resolved against a registry or
# pulled, see stage.env's own comment for why `docker compose config` still
# needs these present.
DGLAUNDRY_OTEL_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_PROMETHEUS_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_GRAFANA_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_MYSQL_EXPORTER_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_NODE_EXPORTER_IMAGE=inert-monitoring-profile-not-used-on-this-host
DGLAUNDRY_ALERTMANAGER_IMAGE=inert-monitoring-profile-not-used-on-this-host

# DGFY outbound events stay OFF on first enablement (same as stage.env): the worker
# requires DGFY_OUTBOUND_URL, KEY_ID and the signing key together or not at all, so
# DGLAUNDRY_DGFY_OUTBOUND_URL and DGLAUNDRY_DGFY_OUTBOUND_KEY_ID must BOTH stay unset
# until events are deliberately enabled (setting only the key ID crash-loops the
# worker -- seen on staging 2026-10-16). connect-dgfy-prod.sh already stored the
# outbound signing key (DGFY_OUTBOUND_SIGNING_KEY) and auth token for that day.
