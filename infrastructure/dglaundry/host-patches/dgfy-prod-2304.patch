+  "secrets/dglaundry-machine-assertion.pub.pem:DGFY_DGLAUNDRY_MACHINE_CLIENT_PUBLIC_KEY"
+  "secrets/dglaundry-request-signing.pub.pem:DGLAUNDRY_PARTNER_REQUEST_PUBLIC_KEY"
