  "architecture_boundaries": {
    "layer_order": [
      "routes",
      "controllers",
      "usecases",
      "repositories",
      "models"
    ],
    "current_flow": [
      "POS UI in packages/web-core and apps/dgfy-pos calls API clients.",
      "API routes in apps/dgfy-api/src/routes apply authentication and permission middleware.",
      "Controllers validate transport input and delegate without direct model access.",
      "Use cases apply business policy and transaction orchestration.",
      "Repositories perform tenant-scoped persistence and read-model access.",
      "Models define the tenant or landlord persistence schema."
    ],
    "target_flow": [
      {
        "step": 1,
        "action": "Operator or reviewer requests readiness, sample, report, journal, audit, screenshot, or disaster-recovery evidence.",
        "owner": "POS or compliance UI",
        "source_of_truth": "Existing POS fiscal sources and tenant-scoped compliance records",
        "evidence_output": "Request context only"
      },
      {
        "step": 2,
        "action": "Controller validates tenant, branch, terminal, date range, artifact type, and policy-version inputs.",
        "owner": "API controllers and validators",
        "source_of_truth": "Authenticated request context plus server-owned policy",
        "evidence_output": "Validated use-case command"
      },
      {
        "step": 3,
        "action": "Use case checks permission, compliance mode, location access, freshness, and final or provisional source state.",
        "owner": "Compliance or POS use case",
        "source_of_truth": "Server policy and immutable source-state metadata",
        "evidence_output": "Authorized read plan"
      },
      {
        "step": 4,
        "action": "Repositories read immutable fiscal snapshots, adjustments, fiscal events, X/Z snapshots, reports, audit records, and approved settings or version metadata.",
        "owner": "POS, reports, business-admin, and compliance repositories",
        "source_of_truth": "Existing authoritative records listed in source_of_truth_contract",
        "evidence_output": "Ordered source snapshot"
      },
      {
        "step": 5,
        "action": "A deterministic serializer validates completeness, computes SHA-256, and emits a manifest.",
        "owner": "Later evidence-generation implementation phase",
        "source_of_truth": "Read-only source snapshot plus policy and serializer versions",
        "evidence_output": "Artifact bytes and checksum manifest"
      },
      {
        "step": 6,
        "action": "Final-review evidence stores artifact metadata, source revision, generator version, checksum, review state, and external-review status.",
        "owner": "Compliance final-review persistence",
        "source_of_truth": "TenantComplianceFinalReviewDocument and Signoff, extended only by a later approved schema phase",
        "evidence_output": "Tenant-scoped evidence metadata"
      },
      {
        "step": 7,
        "action": "The response returns only an authorized artifact or manifest usable for local capture or hard-copy projection.",
        "owner": "API transport and POS UI",
        "source_of_truth": "Authorized source snapshot and reviewed evidence metadata",
        "evidence_output": "Scoped artifact response"
      }
    ]
  },
